---
// BorderBox Component - Primary container with heavy borders and optional corner accents
export interface Props {
  variant?: 'default' | 'accent' | 'corners' | 'elevated' | 'clipped' | 'tactical';
  accentColor?: 'orange' | 'green' | 'blue' | 'red';
  class?: string;
}

const {
  variant = 'default',
  accentColor = 'orange',
  class: className = ''
} = Astro.props;
---

<div class={`border-box border-box--${variant} ${className}`} data-accent={accentColor}>
  <slot />
</div>

<style>
  .border-box {
    border: var(--border-thick) solid var(--border-heavy);
    padding: var(--space-4);
    background: var(--bg-elevated);
    position: relative;
    transition: border-color var(--transition-base);
  }

  /* Default variant - standard black border */
  .border-box--default {
    /* Uses base styles */
  }

  /* Accent variant - colored left border */
  .border-box--accent {
    border-left-width: var(--border-heavy-width);
  }

  .border-box--accent[data-accent="orange"] {
    border-left-color: var(--accent-orange);
  }

  .border-box--accent[data-accent="green"] {
    border-left-color: var(--accent-green);
  }

  .border-box--accent[data-accent="blue"] {
    border-left-color: var(--accent-blue);
  }

  .border-box--accent[data-accent="red"] {
    border-left-color: var(--accent-red);
  }

  /* Corners variant - registration marks in corners */
  .border-box--corners::before,
  .border-box--corners::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    border: var(--border-medium) solid var(--border-heavy);
  }

  .border-box--corners::before {
    top: -2px;
    left: -2px;
    border-right: none;
    border-bottom: none;
  }

  .border-box--corners::after {
    bottom: -2px;
    right: -2px;
    border-left: none;
    border-top: none;
  }

  /* Elevated variant - with shadow */
  .border-box--elevated {
    box-shadow: var(--shadow-medium);
  }

  .border-box--elevated:hover {
    box-shadow: var(--shadow-heavy);
  }

  /* Clipped variant - angled corners (military spec sheet style) */
  .border-box--clipped {
    clip-path: polygon(
      0 12px,
      12px 0,
      calc(100% - 12px) 0,
      100% 12px,
      100% calc(100% - 12px),
      calc(100% - 12px) 100%,
      12px 100%,
      0 calc(100% - 12px)
    );
    border: none;
    background: var(--bg-elevated);
    position: relative;
  }

  .border-box--clipped::before {
    content: '';
    position: absolute;
    inset: 3px;
    background: var(--bg-elevated);
    clip-path: polygon(
      0 11px,
      11px 0,
      calc(100% - 11px) 0,
      100% 11px,
      100% calc(100% - 11px),
      calc(100% - 11px) 100%,
      11px 100%,
      0 calc(100% - 11px)
    );
    z-index: -1;
  }

  .border-box--clipped::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--border-heavy);
    clip-path: polygon(
      0 12px,
      12px 0,
      calc(100% - 12px) 0,
      100% 12px,
      100% calc(100% - 12px),
      calc(100% - 12px) 100%,
      12px 100%,
      0 calc(100% - 12px)
    );
    z-index: -2;
  }

  /* Tactical variant - with corner registration marks and crosshairs */
  .border-box--tactical {
    position: relative;
  }

  .border-box--tactical::before,
  .border-box--tactical::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    border: var(--border-medium) solid var(--accent-orange);
  }

  .border-box--tactical::before {
    top: -3px;
    left: -3px;
    border-right: none;
    border-bottom: none;
  }

  .border-box--tactical::after {
    bottom: -3px;
    right: -3px;
    border-left: none;
    border-top: none;
  }

  /* Additional corner marks for tactical variant */
  .border-box--tactical {
    background-image:
      linear-gradient(to right, var(--accent-orange) 2px, transparent 2px),
      linear-gradient(to bottom, var(--accent-orange) 2px, transparent 2px),
      linear-gradient(to right, var(--accent-orange) 2px, transparent 2px),
      linear-gradient(to bottom, var(--accent-orange) 2px, transparent 2px);
    background-size: 20px 20px;
    background-position: top -3px right -3px, top -3px right -3px, bottom -3px left -3px, bottom -3px left -3px;
    background-repeat: no-repeat;
  }

  /* Hover state for all variants */
  .border-box:hover {
    border-color: var(--accent-blue);
  }

  .border-box--tactical:hover::before,
  .border-box--tactical:hover::after {
    border-color: var(--accent-blue);
  }

  @media (max-width: 768px) {
    .border-box {
      padding: var(--space-3);
    }

    .border-box--clipped {
      clip-path: polygon(
        0 8px,
        8px 0,
        calc(100% - 8px) 0,
        100% 8px,
        100% calc(100% - 8px),
        calc(100% - 8px) 100%,
        8px 100%,
        0 calc(100% - 8px)
      );
    }
  }
</style>
