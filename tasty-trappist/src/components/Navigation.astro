---
// Navigation Component - Military-style top navigation
import SpinningGlobe from "./SpinningGlobe.svelte";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
    { href: "/", label: "HOME" },
    { href: "/about", label: "ABOUT" },
    { href: "/experience", label: "EXPERIENCE" },
    { href: "/skills", label: "SKILLS" },
    { href: "/projects", label: "PROJECTS" },
];
---

<nav class="main-nav" aria-label="Primary">
    <div class="container nav-container">
        <a href="/" class="nav-logo" aria-label="Samantha Myers — Home">
            <div class="logo-icon">
                <SpinningGlobe client:load />
            </div>
            <span class="logo-text">SAMANTHA MYERS</span>
        </a>

        <button
            class="mobile-menu-toggle"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="primary-links"
        >
            <span class="hamburger"></span>
            <span class="hamburger"></span>
            <span class="hamburger"></span>
        </button>

        <div class="nav-links" id="primary-links">
            {
                navLinks.map((link) => (
                    <a
                        href={link.href}
                        class={`nav-link ${currentPath === link.href ? "nav-link--active" : ""}`}
                        aria-current={currentPath === link.href ? "page" : undefined}
                    >
                        {link.label}
                    </a>
                ))
            }
            <button class="theme-toggle" aria-label="Toggle dark mode" aria-pressed="false" title="Toggle dark mode">
                <span class="theme-icon theme-icon--light">☀</span>
                <span class="theme-icon theme-icon--dark">☾</span>
            </button>
            <a href="/contact" class="nav-cta">CONTACT</a>
        </div>
    </div>
</nav>

<script>
    const nav = document.querySelector<HTMLElement>(".main-nav")!;
    const toggle = nav.querySelector<HTMLButtonElement>(".mobile-menu-toggle")!;
    const links = nav.querySelector<HTMLElement>(".nav-links")!;
    const mobile = window.matchMedia("(max-width: 1199px)");
    const theme = nav.querySelector<HTMLButtonElement>(".theme-toggle")!;
    // CSS can blur a newly hidden control before the media-query event fires.
    let lastFocused: EventTarget | null = null;
    document.addEventListener("focusin", (event) => { lastFocused = event.target; });

    function save(key: string, value: string) {
        // Preferences still work in this document when browser storage is blocked.
        try { localStorage.setItem(key, value); } catch { /* Storage is optional. */ }
    }
    function setOpen(open: boolean) {
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        links.classList.toggle("nav-links--open", open);
        links.inert = mobile.matches && !open;
    }
    setOpen(false);
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    nav.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
            setOpen(false);
            toggle.focus();
        }
    });
    nav.addEventListener("focusout", (event) => {
        if (!nav.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    document.addEventListener("pointerdown", (event) => {
        if (!nav.contains(event.target as Node)) {
            lastFocused = null;
            setOpen(false);
        }
    });
    mobile.addEventListener("change", () => {
        if (mobile.matches && links.contains(lastFocused as Node | null)) toggle.focus();
        const restoreDesktopFocus = !mobile.matches && lastFocused === toggle;
        setOpen(false);
        if (restoreDesktopFocus) links.querySelector<HTMLAnchorElement>("a")?.focus();
    });
    theme.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "dark"));
    theme.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        theme.setAttribute("aria-pressed", String(next === "dark"));
        save("theme", next);
    });
</script>

<style>
    :global(html:not(.js)) .theme-toggle {
        display: none;
    }

    .main-nav {
        background: var(--bg-elevated);
        border-bottom: var(--border-thick) solid var(--border-heavy);
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        backdrop-filter: blur(8px);
    }

    .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        padding-top: var(--space-2);
        padding-bottom: var(--space-2);
    }

    .nav-logo {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        text-decoration: none;
        color: var(--text-primary);
        transition: color var(--transition-fast);
    }

    .nav-logo::before,
    .nav-logo::after {
        text-decoration: none;
    }

    .nav-logo:hover {
        color: var(--accent-blue);
    }

    .logo-icon {
        color: var(--accent-orange);
    }

    .logo-text {
        font-family: var(--font-primary);
        font-size: var(--text-lg);
        font-weight: var(--font-bold);
        letter-spacing: var(--tracking-wider);
        text-transform: uppercase;
    }

    .mobile-menu-toggle {
        display: none;
        flex-direction: column;
        gap: 4px;
        background: none;
        border: none;
        cursor: pointer;
        padding: var(--space-1);
        z-index: calc(var(--z-sticky) + 1);
    }

    .hamburger {
        width: 24px;
        height: 3px;
        background: var(--text-primary);
        transition: all var(--transition-base);
    }

    .mobile-menu-toggle[aria-expanded="true"] .hamburger:nth-child(1) {
        transform: rotate(45deg) translate(6px, 6px);
    }

    .mobile-menu-toggle[aria-expanded="true"] .hamburger:nth-child(2) {
        opacity: 0;
    }

    .mobile-menu-toggle[aria-expanded="true"] .hamburger:nth-child(3) {
        transform: rotate(-45deg) translate(6px, -6px);
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: var(--space-1);
    }

    .nav-link {
        font-family: var(--font-primary);
        font-size: var(--text-sm);
        font-weight: var(--font-semibold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        color: var(--text-primary);
        text-decoration: none;
        padding: var(--space-1) var(--space-2);
        border-bottom: 2px solid transparent;
        transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
    }

    /* Prevent global underline from leaking into nav links or their ::before */
    .nav-link,
    .nav-link::before,
    .nav-link::after {
        text-decoration: none;
    }

    .nav-link:hover {
        color: var(--accent-blue);
        border-bottom-color: var(--accent-blue);
    }

    .nav-link--active {
        color: var(--accent-orange);
        border-bottom-color: var(--accent-orange);
        position: relative;
    }

    .nav-link--active::before {
        content: "\25B8";
        margin-right: 0.25em;
    }

    .theme-toggle {
        background: none;
        border: var(--border-medium) solid var(--border-light);
        color: var(--text-primary);
        cursor: pointer;
        padding: var(--space-1) var(--space-2);
        display: flex;
        align-items: center;
        gap: var(--space-1);
        transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
        font-size: var(--text-lg);
    }

    .theme-toggle:hover {
        border-color: var(--accent-blue);
        background: var(--bg-secondary);
    }

    .theme-icon {
        transition: opacity var(--transition-fast);
    }

    .theme-icon--dark {
        display: none;
    }

    [data-theme="dark"] .theme-icon--light {
        display: none;
    }

    [data-theme="dark"] .theme-icon--dark {
        display: inline;
    }

    .nav-cta {
        font-family: var(--font-primary);
        font-size: var(--text-sm);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        background: var(--accent-orange);
        color: var(--text-inverted);
        padding: var(--space-2) var(--space-3);
        border: var(--border-medium) solid var(--border-heavy);
        text-decoration: none;
        transition: background var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
    }

    .nav-cta::before,
    .nav-cta::after {
        text-decoration: none;
    }

    .nav-cta:hover {
        background: var(--accent-red);
        transform: translate(-2px, -2px);
        box-shadow: 3px 3px 0 var(--border-heavy);
    }

    /* Mobile styles */
    @media (max-width: 1199px) {
        .nav-container {
            padding: var(--space-2);
            flex-wrap: wrap;
        }

        .logo-text {
            font-size: var(--text-base);
        }

        :global(.js) .mobile-menu-toggle {
            display: flex;
            min-width: 44px;
            min-height: 44px;
            align-items: center;
            justify-content: center;
        }

        .nav-links {
            width: 100%;
            background: var(--bg-elevated);
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            overflow-y: auto;
            overscroll-behavior: contain;
        }

        :global(.js) .nav-links {
            position: absolute;
            top: 100%;
            right: 0;
            width: min(360px, 100%);
            /* Reserve room for the nav and ticker even before the page scrolls. */
            max-height: calc(100dvh - 150px);
            border: var(--border-thick) solid var(--border-heavy);
            visibility: hidden;
            opacity: 0;
            transform: translateY(-8px);
            transition: opacity var(--transition-fast), transform var(--transition-fast), visibility var(--transition-fast);
        }

        :global(.js) .nav-links--open {
            visibility: visible;
            opacity: 1;
            transform: translateY(0);
        }

        .nav-link {
            padding: var(--space-3) var(--space-4);
            border-bottom: 1px solid var(--border-light);
            border-left: 3px solid transparent;
        }

        .nav-link:hover,
        .nav-link--active {
            border-bottom-color: transparent;
            border-left-color: var(--accent-orange);
            background: var(--bg-secondary);
        }

        .theme-toggle {
            margin: var(--space-2) var(--space-4);
            justify-content: center;
            width: calc(100% - var(--space-8));
        }

        .nav-cta {
            margin: var(--space-3) var(--space-4);
            text-align: center;
        }

    }

    @media (max-width: 480px) {
        .logo-text {
            display: none;
        }

        :global(.js) .nav-links {
            width: 100%;
        }
    }
</style>
