---
// Navigation Component - Military-style top navigation
import SpinningGlobe from "./SpinningGlobe.svelte";

const currentPath = Astro.url.pathname;

const navLinks = [
    { href: "/", label: "HOME" },
    { href: "/about", label: "ABOUT" },
    { href: "/experience", label: "EXPERIENCE" },
    { href: "/skills", label: "SKILLS" },
    { href: "/projects", label: "PROJECTS" },
];
---

<nav class="main-nav">
    <div class="container nav-container">
        <a href="/" class="nav-logo">
            <div class="logo-icon">
                <SpinningGlobe client:load />
            </div>
            <span class="logo-text">SAMANTHA MYERS</span>
        </a>

        <button
            class="mobile-menu-toggle"
            aria-label="Toggle menu"
            aria-expanded="false"
        >
            <span class="hamburger"></span>
            <span class="hamburger"></span>
            <span class="hamburger"></span>
        </button>

        <div class="nav-links">
            {
                navLinks.map((link) => (
                    <a
                        href={link.href}
                        class={`nav-link ${currentPath === link.href ? "nav-link--active" : ""}`}
                        aria-current={currentPath === link.href ? "page" : undefined}
                    >
                        {link.label}
                    </a>
                ))
            }
            <button class="theme-toggle" aria-label="Toggle dark mode" aria-pressed="false" title="Toggle dark mode">
                <span class="theme-icon theme-icon--light">☀</span>
                <span class="theme-icon theme-icon--dark">☾</span>
            </button>
            <a href="/contact" class="nav-cta">CONTACT</a>
        </div>
    </div>
</nav>

<script>
    // Theme toggle functionality
    let currentThemeButton: HTMLButtonElement | null = null;

    function applyTheme() {
        // Check for saved theme preference or default to 'light'
        const savedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const currentTheme = savedTheme || (prefersDark ? "dark" : "light");

        // Apply theme
        document.documentElement.setAttribute("data-theme", currentTheme);
        return currentTheme;
    }

    function handleThemeToggle() {
        const currentTheme = document.documentElement.getAttribute("data-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";

        document.documentElement.setAttribute("data-theme", newTheme);
        localStorage.setItem("theme", newTheme);

        const themeToggle = document.querySelector(".theme-toggle");
        if (themeToggle) {
            themeToggle.setAttribute("aria-pressed", newTheme === "dark" ? "true" : "false");
        }
    }

    function initTheme() {
        const currentTheme = applyTheme();
        const themeToggle = document.querySelector(".theme-toggle") as HTMLButtonElement | null;

        // Update toggle button state
        if (themeToggle) {
            themeToggle.setAttribute("aria-pressed", currentTheme === "dark" ? "true" : "false");

            // Remove old event listener if button changed (View Transitions)
            if (currentThemeButton && currentThemeButton !== themeToggle) {
                currentThemeButton.removeEventListener("click", handleThemeToggle);
            }

            // Add event listener if it's a new button or first time
            if (currentThemeButton !== themeToggle) {
                themeToggle.addEventListener("click", handleThemeToggle);
                currentThemeButton = themeToggle;
            }
        }
    }

    // Use astro:page-load for View Transitions compatibility
    document.addEventListener("astro:page-load", () => {
        // Always apply theme on page load
        applyTheme();

        // Initialize theme toggle (handles new button after navigation)
        initTheme();

        const toggle = document.querySelector(".mobile-menu-toggle");
        const navLinks = document.querySelector(".nav-links");
        const logo = document.querySelector(".nav-logo");

        // Prevent logo from refreshing if on home page
        if (logo) {
            logo.addEventListener("click", (e) => {
                const currentPath = window.location.pathname;
                const logoPath = new URL(logo.href).pathname;

                if (currentPath === logoPath) {
                    e.preventDefault();
                    return false;
                }
            });
        }

        if (toggle && navLinks) {
            toggle.addEventListener("click", () => {
                const isExpanded =
                    toggle.getAttribute("aria-expanded") === "true";
                toggle.setAttribute("aria-expanded", (!isExpanded).toString());
                navLinks.classList.toggle("nav-links--open");
                document.body.classList.toggle("nav-open");
            });

            // Handle navigation link clicks
            const links = navLinks.querySelectorAll("a.nav-link, a.nav-cta");
            links.forEach((link) => {
                link.addEventListener("click", (e) => {
                    // Close mobile menu
                    toggle.setAttribute("aria-expanded", "false");
                    navLinks.classList.remove("nav-links--open");
                    document.body.classList.remove("nav-open");

                    // Prevent navigation if clicking on current page
                    const currentPath = window.location.pathname;
                    const linkPath = new URL(link.href).pathname;

                    if (currentPath === linkPath) {
                        e.preventDefault();
                        return false;
                    }
                });
            });
        }
    });

    // Initialize theme immediately on first load (before DOMContentLoaded to prevent flash)
    applyTheme();

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initTheme);
    } else {
        initTheme();
    }
</script>

<style>
    .main-nav {
        background: var(--bg-elevated);
        border-bottom: var(--border-thick) solid var(--border-heavy);
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        backdrop-filter: blur(8px);
    }

    .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        padding-top: var(--space-2);
        padding-bottom: var(--space-2);
    }

    .nav-logo {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        text-decoration: none;
        color: var(--text-primary);
        transition: color var(--transition-fast);
    }

    .nav-logo:hover {
        color: var(--accent-blue);
    }

    .logo-icon {
        color: var(--accent-orange);
    }

    .logo-text {
        font-family: var(--font-primary);
        font-size: var(--text-lg);
        font-weight: var(--font-bold);
        letter-spacing: var(--tracking-wider);
        text-transform: uppercase;
    }

    .mobile-menu-toggle {
        display: none;
        flex-direction: column;
        gap: 4px;
        background: none;
        border: none;
        cursor: pointer;
        padding: var(--space-1);
        z-index: calc(var(--z-sticky) + 1);
    }

    .hamburger {
        width: 24px;
        height: 3px;
        background: var(--text-primary);
        transition: all var(--transition-base);
    }

    .mobile-menu-toggle[aria-expanded="true"] .hamburger:nth-child(1) {
        transform: rotate(45deg) translate(6px, 6px);
    }

    .mobile-menu-toggle[aria-expanded="true"] .hamburger:nth-child(2) {
        opacity: 0;
    }

    .mobile-menu-toggle[aria-expanded="true"] .hamburger:nth-child(3) {
        transform: rotate(-45deg) translate(6px, -6px);
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: var(--space-4);
    }

    .nav-link {
        font-family: var(--font-primary);
        font-size: var(--text-sm);
        font-weight: var(--font-semibold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        color: var(--text-primary);
        text-decoration: none;
        padding: var(--space-1) var(--space-2);
        border-bottom: 2px solid transparent;
        transition: all var(--transition-fast);
    }

    .nav-link:hover {
        color: var(--accent-blue);
        border-bottom-color: var(--accent-blue);
    }

    .nav-link--active {
        color: var(--accent-orange);
        border-bottom-color: var(--accent-orange);
        position: relative;
    }

    .nav-link--active::before {
        content: "▸";
        margin-right: 0.25em;
    }

    .theme-toggle {
        background: none;
        border: var(--border-medium) solid var(--border-light);
        color: var(--text-primary);
        cursor: pointer;
        padding: var(--space-1) var(--space-2);
        display: flex;
        align-items: center;
        gap: var(--space-1);
        transition: all var(--transition-fast);
        font-size: var(--text-lg);
    }

    .theme-toggle:hover {
        border-color: var(--accent-blue);
        background: var(--bg-secondary);
    }

    .theme-icon {
        transition: opacity var(--transition-fast);
    }

    .theme-icon--dark {
        display: none;
    }

    [data-theme="dark"] .theme-icon--light {
        display: none;
    }

    [data-theme="dark"] .theme-icon--dark {
        display: inline;
    }

    .nav-cta {
        font-family: var(--font-primary);
        font-size: var(--text-sm);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        background: var(--accent-orange);
        color: var(--text-inverted);
        padding: var(--space-2) var(--space-3);
        border: var(--border-medium) solid var(--border-heavy);
        text-decoration: none;
        transition: all var(--transition-fast);
    }

    .nav-cta:hover {
        background: var(--accent-red);
        transform: translate(-2px, -2px);
        box-shadow: 3px 3px 0 var(--border-heavy);
    }

    /* Mobile styles */
    @media (max-width: 768px) {
        .nav-container {
            padding: var(--space-2);
        }

        .logo-text {
            font-size: var(--text-base);
        }

        .mobile-menu-toggle {
            display: flex;
        }

        .nav-links {
            position: fixed;
            top: 0;
            right: -100%;
            width: 280px;
            max-width: 80vw;
            height: 100vh;
            height: 100dvh; /* Use dynamic viewport height on mobile */
            background: var(--bg-elevated);
            border-left: var(--border-thick) solid var(--border-heavy);
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            padding-top: 80px;
            transition: right var(--transition-base);
            /* Prevent menu from extending beyond viewport */
            overflow-y: auto;
            overscroll-behavior: contain;
        }

        .nav-links--open {
            right: 0;
        }

        .nav-link {
            padding: var(--space-3) var(--space-4);
            border-bottom: 1px solid var(--border-light);
            border-left: 3px solid transparent;
        }

        .nav-link:hover,
        .nav-link--active {
            border-bottom-color: transparent;
            border-left-color: var(--accent-orange);
            background: var(--bg-secondary);
        }

        .theme-toggle {
            margin: var(--space-2) var(--space-4);
            justify-content: center;
            width: calc(100% - var(--space-8));
        }

        .nav-cta {
            margin: var(--space-3) var(--space-4);
            text-align: center;
        }

        /* Prevent body scroll when menu is open */
        :global(body.nav-open) {
            overflow: hidden;
            position: fixed;
            width: 100%;
            height: 100vh;
            /* Prevent any horizontal movement */
            overscroll-behavior: none;
            touch-action: none;
        }
    }

    @media (max-width: 480px) {
        .logo-text {
            display: none;
        }
    }
</style>
