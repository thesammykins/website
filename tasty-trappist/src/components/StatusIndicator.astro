---
// StatusIndicator Component - Pulsing status light with label
export interface Props {
  status?: 'active' | 'standby' | 'offline' | 'alert';
  label?: string;
  showLabel?: boolean;
  size?: 'sm' | 'md' | 'lg';
  pulse?: boolean;
}

const {
  status = 'active',
  label = 'SYSTEM',
  showLabel = true,
  size = 'md',
  pulse = true
} = Astro.props;

const statusColors = {
  active: 'var(--accent-green)',
  standby: 'var(--accent-yellow)',
  offline: 'var(--text-tertiary)',
  alert: 'var(--accent-red)'
};

const statusLabels = {
  active: 'OPERATIONAL',
  standby: 'STANDBY',
  offline: 'OFFLINE',
  alert: 'ALERT'
};
---

<div class={`status-indicator status-indicator--${size}`}>
  <div class={`status-light status-light--${status} ${pulse ? 'status-light--pulse' : ''}`}>
    <span class="status-dot"></span>
  </div>
  {showLabel && (
    <div class="status-info">
      {label && <span class="status-label">{label}:</span>}
      <span class={`status-value status-value--${status}`}>
        {statusLabels[status]}
      </span>
    </div>
  )}
</div>

<style>
  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Size variants */
  .status-indicator--sm {
    gap: var(--space-1);
  }

  .status-indicator--lg {
    gap: var(--space-3);
  }

  /* Status light */
  .status-light {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .status-dot {
    display: block;
    border-radius: 50%;
    background: currentColor;
  }

  .status-indicator--sm .status-dot {
    width: 8px;
    height: 8px;
  }

  .status-indicator--md .status-dot {
    width: 12px;
    height: 12px;
  }

  .status-indicator--lg .status-dot {
    width: 16px;
    height: 16px;
  }

  /* Status colors */
  .status-light--active {
    color: var(--accent-green);
  }

  .status-light--standby {
    color: var(--accent-yellow);
  }

  .status-light--offline {
    color: var(--text-tertiary);
  }

  .status-light--alert {
    color: var(--accent-red);
  }

  /* Pulse animation */
  .status-light--pulse .status-dot {
    animation: statusPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .status-light--alert.status-light--pulse .status-dot {
    animation: statusBlink 1s linear infinite;
  }

  @keyframes statusPulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.95);
    }
  }

  @keyframes statusBlink {
    0%, 50%, 100% {
      opacity: 1;
    }
    25%, 75% {
      opacity: 0.3;
    }
  }

  /* Glow effect for active status */
  .status-light--active .status-dot::before,
  .status-light--alert .status-dot::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.2;
    animation: statusGlow 2s ease-in-out infinite;
  }

  @keyframes statusGlow {
    0%, 100% {
      transform: scale(1);
      opacity: 0.2;
    }
    50% {
      transform: scale(1.3);
      opacity: 0;
    }
  }

  /* Status info */
  .status-info {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .status-indicator--sm .status-info {
    font-size: var(--text-xs);
  }

  .status-indicator--md .status-info {
    font-size: var(--text-sm);
  }

  .status-indicator--lg .status-info {
    font-size: var(--text-base);
  }

  .status-label {
    color: var(--text-tertiary);
    font-weight: var(--font-bold);
  }

  .status-value {
    font-weight: var(--font-bold);
  }

  .status-value--active {
    color: var(--accent-green);
  }

  .status-value--standby {
    color: var(--accent-yellow);
  }

  .status-value--offline {
    color: var(--text-tertiary);
  }

  .status-value--alert {
    color: var(--accent-red);
  }

  /* Disable animations for reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .status-light--pulse .status-dot,
    .status-dot::before {
      animation: none;
    }
  }
</style>
