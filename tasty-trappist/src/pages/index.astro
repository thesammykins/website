---
// Homepage - Streamlined Defense Intelligence style
import MainLayout from "../layouts/MainLayout.astro";
import BorderBox from "../components/BorderBox.astro";
---

<MainLayout
    title="Home"
    description="Samantha Myers - Technical Support Engineer specializing in IT operations, infrastructure, and strategic systems engineering."
>
    <!-- Page-Level Background Portrait - rendered at body level -->
    <div slot="page-background" class="hero-background">
        <img src="/avatar-pixelated.png" alt="" class="background-portrait" />
        <div class="background-gradient"></div>
        <div class="scan-line"></div>
    </div>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <div class="hero-badge">
                    <span class="badge-text">DOES SUPPORT GOOD®</span>
                </div>

                <h1 class="hero-title">
                    CORPORATE<br />
                    ENGINEERING<br />
                    EXCELLENCE
                </h1>

                <p class="hero-subtitle">
                    Building relationships and working in systems that give
                    teams the advantage in complex environments.
                </p>

                <div class="hero-stats">
                    <div class="stat">
                        <span class="stat-value">10+</span>
                        <span class="stat-label">YEARS</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">100+</span>
                        <span class="stat-label">SYSTEMS</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">ACTIVE</span>
                        <span class="stat-label">STATUS</span>
                    </div>
                </div>

                <div class="hero-cta">
                    <a href="/contact" class="btn btn-primary">CONTACT</a>
                    <a href="/about" class="btn btn-secondary">ABOUT →</a>
                    <a href="/experience" class="btn btn-outline"
                        >OPERATIONS →</a
                    >
                </div>
            </div>
        </div>
    </section>

    <!-- Quick Capabilities - Condensed -->
    <section class="capabilities-compact">
        <div class="container">
            <BorderBox variant="elevated">
                <div class="capabilities-row">
                    <div class="cap-item">
                        <div class="cap-icon">◆</div>
                        <h3 class="cap-title">TECHNICAL SYSTEMS</h3>
                        <p class="cap-desc">
                            Infrastructure, fleet management, cloud operations
                        </p>
                    </div>
                    <div class="cap-item">
                        <div class="cap-icon">▲</div>
                        <h3 class="cap-title">TEAM LEADERSHIP</h3>
                        <p class="cap-desc">
                            Engineering management, service delivery,
                            collaboration
                        </p>
                    </div>
                    <div class="cap-item">
                        <div class="cap-icon">■</div>
                        <h3 class="cap-title">STRATEGIC PLANNING</h3>
                        <p class="cap-desc">
                            System design, optimization, technical solutions
                        </p>
                    </div>
                </div>
            </BorderBox>
        </div>
    </section>

    <!-- Current Role Highlight - Minimal -->
    <section class="current-role">
        <div class="container">
            <h2 class="section-title">■ CURRENT DEPLOYMENT</h2>

            <BorderBox variant="corners">
                <div class="role-grid">
                    <div class="role-info">
                        <h3 class="role-title">
                            CORPORATE ENGINEERING MANAGER
                        </h3>
                        <p class="role-company">Ferocia | Melbourne (Hybrid)</p>
                        <p class="role-period">Nov 2024 – Present</p>
                        <p class="role-desc">
                            Leading cross-functional projects and strategic
                            initiatives. Maintaining alignment between technical
                            systems and organizational objectives.
                        </p>
                    </div>
                    <div class="role-actions">
                        <a href="/experience" class="btn btn-outline"
                            >FULL HISTORY →</a
                        >
                        <a href="/skills" class="btn btn-outline"
                            >CAPABILITIES →</a
                        >
                    </div>
                </div>
            </BorderBox>
        </div>
    </section>
</MainLayout>

<style>
    /* Hero Section with Background Portrait */
    .hero {
        padding: var(--space-6) 0 var(--space-4);
        position: relative;
        min-height: 50vh;
        display: flex;
        align-items: center;
        z-index: 10;
    }

    :global(.hero-background .background-portrait) {
        position: absolute;
        right: -5%;
        top: 50%;
        transform: translateY(-50%);
        height: 100vh;
        width: auto;
        object-fit: contain;
        opacity: 0.25;
    }

    :global(.hero-background .background-gradient) {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(
            to right,
            var(--bg-primary) 0%,
            var(--bg-primary) 20%,
            rgba(208, 247, 244, 0.8) 40%,
            rgba(208, 247, 244, 0.3) 60%,
            transparent 80%
        );
    }

    :global(.hero-background .scan-line) {
        position: absolute;
        width: 100%;
        height: 3px;
        background: linear-gradient(
            to bottom,
            transparent,
            var(--accent-green) 50%,
            transparent
        );
        opacity: 0.2;
        animation: scan 4s linear infinite;
        pointer-events: none;
    }

    @keyframes scan {
        0% {
            top: 0%;
        }
        100% {
            top: 100%;
        }
    }

    .hero .container {
        position: relative;
        z-index: 1;
    }

    .hero-content {
        max-width: 600px;
    }

    .hero-badge {
        display: inline-block;
        padding: var(--space-1) var(--space-2);
        border: var(--border-medium) solid var(--border-heavy);
        background: var(--accent-green);
        color: var(--text-inverted);
        margin-bottom: var(--space-3);
    }

    .badge-text {
        font-family: var(--font-primary);
        font-size: var(--text-xs);
        font-weight: var(--font-bold);
        letter-spacing: var(--tracking-wider);
    }

    .hero-title {
        font-family: var(--font-primary);
        font-size: var(--text-5xl);
        font-weight: var(--font-bold);
        line-height: 0.9;
        letter-spacing: var(--tracking-tight);
        margin-bottom: var(--space-3);
        text-transform: uppercase;
    }

    .hero-subtitle {
        font-family: var(--font-mono);
        font-size: var(--text-base);
        line-height: var(--leading-relaxed);
        color: var(--text-secondary);
        margin-bottom: var(--space-3);
        max-width: 500px;
    }

    .hero-stats {
        display: flex;
        gap: var(--space-4);
        margin-bottom: var(--space-3);
        padding: var(--space-2) 0;
        border-top: var(--border-thin) solid var(--border-light);
        border-bottom: var(--border-thin) solid var(--border-light);
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .stat-value {
        font-family: var(--font-primary);
        font-size: var(--text-2xl);
        font-weight: var(--font-bold);
        color: var(--accent-orange);
    }

    .stat-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wider);
        color: var(--text-tertiary);
    }

    .hero-cta {
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
    }

    /* Capabilities Compact Section */
    .capabilities-compact {
        padding: var(--space-1) 0;
        position: relative;
        z-index: 10;
    }

    .capabilities-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-2);
    }

    .cap-item {
        text-align: center;
        padding: var(--space-2) var(--space-1);
    }

    .cap-icon {
        font-size: var(--text-xl);
        color: var(--accent-orange);
        margin-bottom: var(--space-1);
    }

    .cap-title {
        font-family: var(--font-primary);
        font-size: var(--text-sm);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        margin-bottom: var(--space-1);
        color: var(--text-primary);
    }

    .cap-desc {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: var(--leading-normal);
        color: var(--text-secondary);
        margin: 0;
    }

    /* Current Role Section */
    .current-role {
        padding: var(--space-1) 0 var(--space-3);
        position: relative;
        z-index: 10;
    }

    .section-title {
        font-family: var(--font-primary);
        font-size: var(--text-xl);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        margin-bottom: var(--space-1);
        color: var(--text-primary);
    }

    .role-grid {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: var(--space-2);
        align-items: center;
    }

    .role-title {
        font-family: var(--font-primary);
        font-size: var(--text-lg);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        margin-bottom: 0.25rem;
        color: var(--text-primary);
    }

    .role-company {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--accent-blue);
        margin-bottom: 0.25rem;
    }

    .role-period {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-tertiary);
        margin-bottom: var(--space-1);
    }

    .role-desc {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        line-height: var(--leading-normal);
        color: var(--text-secondary);
        margin: 0;
    }

    .role-actions {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    /* Responsive */
    /* Large tablets and small desktops - 2 columns */
    @media (max-width: 1200px) {
        :global(.hero-background .background-portrait) {
            height: 95vh;
            opacity: 0.23;
            right: -8%;
        }

        .capabilities-row {
            grid-template-columns: repeat(2, 1fr);
            gap: var(--space-3);
        }

        .cap-item {
            padding: var(--space-2);
        }

        .cap-title {
            font-size: var(--text-base);
        }

        .cap-desc {
            font-size: var(--text-sm);
        }

        .capabilities-compact {
            padding: var(--space-2) 0;
        }
    }

    /* Tablets - restore spacing and sizing */
    @media (max-width: 1024px) {
        .hero {
            min-height: 65vh;
        }

        :global(.hero-background .background-portrait) {
            height: 85vh;
            opacity: 0.2;
            right: -10%;
        }

        .capabilities-compact {
            padding: var(--space-3) 0;
        }

        .current-role {
            padding: var(--space-3) 0 var(--space-6);
        }

        .section-title {
            font-size: var(--text-2xl);
            margin-bottom: var(--space-2);
        }

        .role-title {
            font-size: var(--text-xl);
        }

        .role-company {
            font-size: var(--text-base);
        }

        .role-desc {
            font-size: var(--text-base);
            line-height: var(--leading-relaxed);
        }

        .role-grid {
            grid-template-columns: 1fr;
            gap: var(--space-4);
        }

        .role-actions {
            flex-direction: row;
        }
    }

    /* Small tablets - 1 column with border style */
    @media (max-width: 768px) {
        .hero {
            padding: var(--space-6) 0 var(--space-4);
            min-height: 50vh;
        }

        :global(.hero-background .background-portrait) {
            height: 75vh;
            opacity: 0.15;
            right: -15%;
        }

        .capabilities-row {
            grid-template-columns: 1fr;
            gap: var(--space-3);
        }

        .cap-item {
            text-align: left;
            padding: var(--space-2);
            border-left: var(--border-thick) solid var(--accent-orange);
        }

        .cap-icon {
            font-size: var(--text-2xl);
        }
    }

    /* Mobile - smallest screens */
    @media (max-width: 640px) {
        :global(.hero-background .background-portrait) {
            right: -20%;
            height: 65vh;
            opacity: 0.12;
        }

        :global(.hero-background .background-gradient) {
            background: linear-gradient(
                to right,
                var(--bg-primary) 0%,
                var(--bg-primary) 30%,
                rgba(208, 247, 244, 0.9) 50%,
                rgba(208, 247, 244, 0.5) 70%,
                transparent 100%
            );
        }

        .hero-title {
            font-size: var(--text-4xl);
        }

        .hero-stats {
            gap: var(--space-3);
        }

        .stat-value {
            font-size: var(--text-xl);
        }
    }
</style>
