---
// Homepage - Streamlined Defense Intelligence style
import MainLayout from "../layouts/MainLayout.astro";
import BorderBox from "../components/BorderBox.astro";
import PixelatedCanvas from "../components/PixelatedCanvas.svelte";
import TechnicalHeader from "../components/TechnicalHeader.astro";
import TechnicalDivider from "../components/TechnicalDivider.astro";
import StatusIndicator from "../components/StatusIndicator.astro";
---

<MainLayout
    title="Home"
    description="Samantha Myers - Technical Support Engineer specializing in IT support, backend enablement, and strategic systems engineering."
>
    <!-- Page-Level Background Portrait - rendered at body level -->
    <div slot="page-background" class="hero-background">
        <PixelatedCanvas
            src="/hero-home.png"
            alt=""
            className="background-portrait"
            pixelSize={5}
            fadeInterval={1500}
            fadePixelsPerTick={800}
            fadeSpeed={0.02}
            initialOpacityMin={0.85}
            initialOpacityMax={1.0}
            fadeOutMin={0.2}
            fadeOutMax={0.4}
            fadeInMin={0.8}
            fadeInMax={1.0}
            hoverRadius={3}
            hoverFadeStrength={0.6}
            enableHover={true}
            autoRestore={true}
            edgeBlurTop={150}
            edgeBlurLeft={200}
            edgeBlurBottom={150}
            client:load
        />
        <div class="background-gradient"></div>
    </div>

    <!-- Technical Header -->
    <div class="container">
        <TechnicalHeader sector="MELBOURNE" status="OPERATIONAL" showTimestamp={true} />
    </div>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <div class="hero-badge">
                    <span class="badge-text">DOES SUPPORT GOOD®</span>
                </div>

                <h1 class="hero-title">
                    CORPORATE<br />
                    ENGINEERING<br />
                    EXCELLENCE
                </h1>

                <p class="hero-subtitle">
                    Field-tested IT support experience and some leadership under
                    my belt, I specialise in building user-first systems that
                    actually work. Keeping the lights on, one door unlock at a
                    time.
                </p>

                <div class="hero-stats">
                    <div class="stat">
                        <span class="stat-value">14+</span>
                        <span class="stat-label">YEARS</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">100+</span>
                        <span class="stat-label">DEVICES</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">ACTIVE</span>
                        <span class="stat-label">STATUS</span>
                    </div>
                </div>

                <div class="hero-cta">
                    <a href="/contact" class="btn btn-primary">CONTACT</a>
                    <a href="/about" class="btn btn-secondary">ABOUT →</a>
                    <a href="/experience" class="btn btn-outline"
                        >OPERATIONS →</a
                    >
                </div>
            </div>
        </div>
    </section>

    <div class="container">
      <TechnicalDivider label="CAPABILITY OVERVIEW" variant="thick" />
    </div>

    <!-- Quick Capabilities - Condensed -->
    <section class="capabilities-compact">
        <div class="container">
            <h2 class="sr-only">CAPABILITIES</h2>
            <BorderBox variant="tactical">
                <div class="capabilities-row">
                    <div class="cap-item">
                        <div class="cap-icon">◆</div>
                        <h3 class="cap-title">TECHNICAL SYSTEMS</h3>
                        <p class="cap-desc">
                            Infrastructure, fleet management, cloud operations
                        </p>
                    </div>
                    <div class="cap-item">
                        <div class="cap-icon">▲</div>
                        <h3 class="cap-title">TEAM LEADERSHIP</h3>
                        <p class="cap-desc">
                            Engineering management, service delivery,
                            collaboration
                        </p>
                    </div>
                    <div class="cap-item">
                        <div class="cap-icon">■</div>
                        <h3 class="cap-title">STRATEGIC PLANNING</h3>
                        <p class="cap-desc">
                            System design, optimization, technical solutions
                        </p>
                    </div>
                </div>
            </BorderBox>
        </div>
    </section>

    <div class="container">
      <TechnicalDivider label="DEPLOYMENT STATUS" variant="default" />
    </div>

    <!-- Current Role Highlight - Minimal -->
    <section class="current-role">
        <div class="container">
            <h2 class="section-title">
                ■ DEPLOYMENT STATUS
                <StatusIndicator status="active" label="" showLabel={false} size="md" />
            </h2>

            <BorderBox variant="clipped">
                <div class="role-grid">
                    <div class="role-info">
                        <h3 class="role-title">AVAILABLE FOR DEPLOYMENT</h3>
                        <p class="role-company">Actively Seeking New Opportunities</p>
                        <p class="role-period">Jun 2026 – Present</p>
                        <p class="role-desc">
                            Wrapping up at Ferocia and looking for my next role.
                            If you know of something that might be a good fit,
                            I'd love to hear from you.
                        </p>
                    </div>
                    <div class="role-actions">
                        <a href="/contact" class="btn btn-primary"
                            >INITIATE CONTACT →</a
                        >
                        <a href="/experience" class="btn btn-outline"
                            >FULL HISTORY →</a
                        >
                        <a href="/skills" class="btn btn-outline"
                            >CAPABILITIES →</a
                        >
                    </div>
                </div>
            </BorderBox>
        </div>
    </section>

    <div class="container">
      <TechnicalDivider label="FEATURED PROJECTS" variant="default" />
    </div>

    <!-- Featured Projects - Homepage Teaser -->
    <section class="featured-projects">
        <div class="container">
            <h2 class="section-title">
                ■ FEATURED PROJECTS
            </h2>

            <div class="featured-grid">
        <a href="/projects" class="featured-card">
                    <div class="featured-icon">◆</div>
                    <h3 class="featured-name">LGTV MENU BAR</h3>
                    <span class="featured-lang lang-tag--swift">SWIFT</span>
                    <p class="featured-desc">
                        Native macOS menu bar app for LG WebOS TVs
                    </p>
                </a>

                <a href="/projects" class="featured-card">
                    <div class="featured-icon">▲</div>
                    <h3 class="featured-name">PTV_CLI</h3>
                    <span class="featured-lang lang-tag--go">GO</span>
                    <p class="featured-desc">
                        CLI tool for agentic PTV automation
                    </p>
                </a>

                <a href="/projects" class="featured-card">
                    <div class="featured-icon">■</div>
                    <h3 class="featured-name">PTV_MCP</h3>
                    <span class="featured-lang lang-tag--ts">TYPESCRIPT</span>
                    <p class="featured-desc">
                        MCP server for the Victorian PTV API
                    </p>
                </a>
            </div>

            <div class="featured-cta">
                <a href="/projects" class="btn btn-outline"
                    >VIEW ALL PROJECTS →</a
                >
                <a
                    href="https://github.com/thesammykins"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-outline"
                    >GITHUB PROFILE →</a
                >
            </div>
        </div>
    </section>
</MainLayout>

<style>
    /* Hero Section with Background Portrait */
    .hero {
        padding: var(--space-8) 0 var(--space-6);
        position: relative;
        min-height: 50vh;
        display: flex;
        align-items: center;
        z-index: 10;
    }

    :global(.hero-background .background-portrait) {
        position: absolute;
        right: -5%;
        top: 50%;
        transform: translateY(-50%);
        height: 100vh;
        width: auto;
        object-fit: contain;
        opacity: 0.25;
        image-rendering: pixelated;
        image-rendering: -moz-crisp-edges;
        image-rendering: crisp-edges;
    }

    :global(.hero-background .background-gradient) {
        display: none;
    }

    .hero .container {
        position: relative;
        z-index: 1;
    }

    .hero-content {
        max-width: 600px;
    }

    .hero-badge {
        display: inline-block;
        padding: var(--space-2) var(--space-3);
        border: var(--border-thick) solid var(--border-heavy);
        background: var(--accent-green);
        color: var(--text-inverted);
        margin-bottom: var(--space-3);
        box-shadow: var(--shadow-brutal-sm);
    }

    .badge-text {
        font-family: var(--font-primary);
        font-size: var(--text-sm);
        font-weight: var(--font-bold);
        letter-spacing: var(--tracking-wider);
    }

    .hero-title {
        font-family: var(--font-primary);
        font-size: var(--text-5xl);
        font-weight: var(--font-bold);
        line-height: 0.9;
        letter-spacing: var(--tracking-tight);
        margin-bottom: var(--space-3);
        text-transform: uppercase;
    }

    .hero-subtitle {
        font-family: var(--font-mono);
        font-size: var(--text-base);
        line-height: var(--leading-relaxed);
        color: var(--text-secondary);
        margin-bottom: var(--space-3);
        max-width: 500px;
    }

    .hero-stats {
        display: flex;
        gap: var(--space-4);
        margin-bottom: var(--space-3);
        padding: var(--space-2) 0;
        border-top: var(--border-thin) solid var(--border-light);
        border-bottom: var(--border-thin) solid var(--border-light);
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .stat-value {
        font-family: var(--font-primary);
        font-size: var(--text-2xl);
        font-weight: var(--font-bold);
        color: var(--accent-orange);
    }

    .stat-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wider);
        color: var(--text-tertiary);
    }

    .hero-cta {
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
    }

    /* Capabilities Compact Section */
    .capabilities-compact {
        padding: var(--space-6) 0;
        position: relative;
        z-index: 10;
    }

    .capabilities-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-2);
    }

    .cap-item {
        text-align: center;
        padding: var(--space-2) var(--space-1);
    }

    .cap-icon {
        font-size: var(--text-xl);
        color: var(--accent-orange);
        margin-bottom: var(--space-1);
    }

    .cap-title {
        font-family: var(--font-primary);
        font-size: var(--text-sm);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        margin-bottom: var(--space-1);
        color: var(--text-primary);
    }

    .cap-desc {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: var(--leading-normal);
        color: var(--text-secondary);
        margin: 0;
    }

    /* Current Role Section */
    .current-role {
        padding: var(--space-6) 0 var(--space-8);
        position: relative;
        z-index: 10;
    }

    .section-title {
        font-family: var(--font-primary);
        font-size: var(--text-xl);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        margin-bottom: var(--space-1);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    .role-grid {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: var(--space-2);
        align-items: center;
    }

    .role-title {
        font-family: var(--font-primary);
        font-size: var(--text-lg);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        margin-bottom: 0.25rem;
        color: var(--text-primary);
    }

    .role-company {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--accent-blue);
        margin-bottom: 0.25rem;
    }

    .role-period {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-tertiary);
        margin-bottom: var(--space-1);
    }

    .role-desc {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        line-height: var(--leading-normal);
        color: var(--text-secondary);
        margin: 0;
    }

    .role-actions {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    /* Responsive */
    /* Large tablets and small desktops - 2 columns */
    @media (max-width: 1200px) {
        :global(.hero-background .background-portrait) {
            height: 95vh;
            opacity: 0.23;
            right: -8%;
        }

        .capabilities-row {
            grid-template-columns: repeat(2, 1fr);
            gap: var(--space-3);
        }

        .cap-item {
            padding: var(--space-2);
        }

        .cap-title {
            font-size: var(--text-base);
        }

        .cap-desc {
            font-size: var(--text-sm);
        }

        .capabilities-compact {
            padding: var(--space-4) 0;
        }
    }

    /* Tablets - restore spacing and sizing */
    @media (max-width: 1024px) {
        .hero {
            padding: var(--space-6) 0 var(--space-4);
            min-height: 65vh;
        }

        :global(.hero-background .background-portrait) {
            height: 85vh;
            opacity: 0.2;
            right: -10%;
        }

        .capabilities-compact {
            padding: var(--space-4) 0;
        }

        .current-role {
            padding: var(--space-4) 0 var(--space-6);
        }

        .section-title {
            font-size: var(--text-2xl);
            margin-bottom: var(--space-2);
        }

        .role-title {
            font-size: var(--text-xl);
        }

        .role-company {
            font-size: var(--text-base);
        }

        .role-desc {
            font-size: var(--text-base);
            line-height: var(--leading-relaxed);
        }

        .role-grid {
            grid-template-columns: 1fr;
            gap: var(--space-4);
        }

        .role-actions {
            flex-direction: row;
        }

        .featured-grid {
            grid-template-columns: repeat(3, 1fr);
            gap: var(--space-2);
        }

        .featured-card {
            padding: var(--space-3) var(--space-2);
        }

        .featured-name {
            font-size: var(--text-base);
        }

        .featured-desc {
            font-size: var(--text-xs);
        }
    }

    /* Small tablets - 1 column with border style */
    @media (max-width: 768px) {
        .hero {
            padding: var(--space-4) 0 var(--space-3);
            min-height: 50vh;
        }

        :global(.hero-background .background-portrait) {
            height: 75vh;
            opacity: 0.15;
            right: -15%;
        }

        .capabilities-row {
            grid-template-columns: 1fr;
            gap: var(--space-3);
        }

        .cap-item {
            text-align: left;
            padding: var(--space-2);
            border-left: var(--border-thick) solid var(--accent-orange);
        }

        .cap-icon {
            font-size: var(--text-2xl);
        }

        .featured-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Featured Projects Section */
    .featured-projects {
        padding: var(--space-6) 0 var(--space-8);
        position: relative;
        z-index: 10;
    }

    .featured-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-3);
        margin-bottom: var(--space-4);
    }

    .featured-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: var(--space-4) var(--space-3);
        background: var(--bg-elevated);
        border: var(--border-thick) solid var(--border-heavy);
        text-decoration: none;
        transition: all var(--transition-base);
        position: relative;
    }

    .featured-card:hover {
        border-color: var(--accent-blue);
        transform: translate(-2px, -2px);
        box-shadow: var(--shadow-brutal-sm);
    }

    .featured-icon {
        font-size: var(--text-2xl);
        color: var(--accent-orange);
        margin-bottom: var(--space-2);
    }

    .featured-name {
        font-family: var(--font-primary);
        font-size: var(--text-lg);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        color: var(--text-primary);
        margin-bottom: var(--space-2);
    }

    .featured-lang {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        padding: 2px var(--space-1);
        margin-bottom: var(--space-2);
        color: var(--text-inverted);
    }

    :global(.lang-tag--swift) {
        background: var(--accent-orange);
    }

    :global(.lang-tag--go) {
        background: var(--accent-blue);
    }

    :global(.lang-tag--ts) {
        background: var(--accent-blue);
    }

    :global(.lang-tag--python) {
        background: var(--accent-green);
    }

    .featured-desc {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        line-height: var(--leading-normal);
        color: var(--text-secondary);
        margin: 0;
    }

    .featured-cta {
        display: flex;
        gap: var(--space-3);
        justify-content: center;
        flex-wrap: wrap;
    }

    /* Mobile - smallest screens */
    @media (max-width: 640px) {
        .hero {
            padding: var(--space-4) 0 var(--space-2);
        }

        :global(.hero-background .background-portrait) {
            right: -20%;
            height: 65vh;
            opacity: 0.12;
        }

        :global(.hero-background .background-gradient) {
            display: block;
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to right,
                var(--bg-primary) 0%,
                var(--bg-primary) 40%,
                transparent 80%
            );
            pointer-events: none;
        }

        .hero-badge {
            padding: var(--space-1) var(--space-2);
            border-width: 2px;
            box-shadow: 2px 2px 0 var(--border-heavy);
        }

        .badge-text {
            font-size: var(--text-xs);
        }

        .hero-title {
            font-size: var(--text-4xl);
        }

        .hero-stats {
            gap: var(--space-3);
        }

        .stat-value {
            font-size: var(--text-xl);
        }

        /* Show only primary CTA on mobile */
        .hero-cta {
            justify-content: center;
        }

        .hero-cta .btn-secondary,
        .hero-cta .btn-outline {
            display: none;
        }
    }
</style>
