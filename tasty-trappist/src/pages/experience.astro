---
// Experience Page - Tactical Operations Log
import MainLayout from "../layouts/MainLayout.astro";
import TechnicalCard from "../components/TechnicalCard.astro";
import PixelatedCanvas from "../components/PixelatedCanvas.svelte";

// Get logo.dev token from environment (PUBLIC_ prefix makes it available at build time)
const LOGO_DEV_TOKEN = import.meta.env.PUBLIC_LOGO_DEV_TOKEN || '';

// Helper to generate logo.dev URL from company domain
const getLogoUrl = (domain: string | null) => {
    if (!domain) return null;
    if (!LOGO_DEV_TOKEN) {
        // Fallback to local logos if no token provided
        return null;
    }
    // Use size=120 for display, retina=true for 2x resolution (240px source)
    // This ensures crisp logos on high-DPI displays
    return `https://img.logo.dev/${domain}?token=${LOGO_DEV_TOKEN}&format=png&size=120&retina=true`;
};

const experiences = [
    {
        title: "TECHNICAL SUPPORT ENGINEER",
