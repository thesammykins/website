---
// Experience Page - Tactical Operations Log
import MainLayout from '../layouts/MainLayout.astro';
import TechnicalCard from '../components/TechnicalCard.astro';

const experiences = [
  {
    title: 'CORPORATE ENGINEERING MANAGER',
    company: 'Ferocia',
    companyUrl: 'https://ferocia.com.au/',
    location: 'Melbourne (Hybrid)',
    period: 'Nov 2024 – Present',
    description: 'Leading cross-functional projects and strategic initiatives while maintaining alignment between technical systems and organizational objectives.',
    achievements: [
      'Architecting scalable corporate engineering systems',
      'Managing strategic technology initiatives',
      'Optimizing cross-functional team collaboration',
      'Driving operational excellence across IT operations'
    ],
    tags: ['LEADERSHIP', 'STRATEGY', 'OPERATIONS', 'MANAGEMENT']
  },
  {
    title: 'TECHNICAL SUPPORT ENGINEER',
    company: 'Ferocia',
    companyUrl: 'https://ferocia.com.au/',
    location: 'Melbourne',
    period: 'Jan 2023 – Nov 2024',
    description: 'Managed IT infrastructure and support operations, specializing in device management, network operations, and user-first service delivery.',
    achievements: [
      'Maintained 99.9% uptime for critical corporate infrastructure',
      'Managed fleet of 100+ devices using Jamf MDM',
      'Implemented automated onboarding workflows',
      'Designed and documented IT operational procedures'
    ],
    tags: ['INFRASTRUCTURE', 'SUPPORT', 'JAMF', 'SYSTEMS']
  },
  {
    title: 'SERVICE DESK LEAD',
    company: 'Redbubble',
    companyUrl: 'https://www.redbubble.com/',
    location: 'Melbourne',
    period: 'Jun 2022 – Dec 2022',
    description: 'Led a team of 3 support technicians, managing service delivery, team development, and operational improvements.',
    achievements: [
      'Conducted regular 1:1s and team performance reviews',
      'Implemented ticket prioritization system reducing response time by 40%',
      'Improved team collaboration through process optimization',
      'Maintained high customer satisfaction scores (4.8/5)'
    ],
    tags: ['TEAM LEAD', 'SERVICE DELIVERY', 'PROCESS IMPROVEMENT']
  },
  {
    title: 'IT SUPPORT TECHNICIAN',
    company: 'Redbubble',
    companyUrl: 'https://www.redbubble.com/',
    location: 'Melbourne',
    period: 'May 2021 – Jun 2022',
    description: 'Managed onboarding, support tooling, and user training programs for a rapidly growing tech company.',
    achievements: [
      'Onboarded 50+ new employees with custom training materials',
      'Built comprehensive IT knowledge base and documentation',
      'Managed Google Workspace and Okta identity management',
      'Created memorable onboarding experiences for new hires'
    ],
    tags: ['ONBOARDING', 'TRAINING', 'GOOGLE WORKSPACE', 'OKTA']
  },
  {
    title: 'SERVICE DESK AGENT',
    company: 'Kineo',
    companyUrl: 'https://kineo.com/',
    location: 'Adelaide',
    period: 'May 2019 – May 2021',
    description: 'Provided technical support for Totara LMS, SCORM packages, and client systems. Specialized in developer-to-client translation.',
    achievements: [
      'Supported 100+ clients across education and enterprise sectors',
      'Debugged complex SCORM and LMS integration issues',
      'Translated technical requirements between developers and clients',
      'Maintained 95% first-contact resolution rate'
    ],
    tags: ['LMS', 'TECHNICAL SUPPORT', 'CLIENT SERVICES']
  },
  {
    title: 'AT HOME ADVISOR',
    company: 'Apple',
    companyUrl: 'https://www.apple.com/',
    location: 'Remote',
    period: 'Apr 2017 – Feb 2018',
    description: 'Provided iOS and macOS technical support, handling bug reports, escalations, and fraud investigations.',
    achievements: [
      'Maintained top 10% customer satisfaction rating',
      'Handled complex technical escalations and bug reports',
      'Processed fraud investigations and account security',
      'Contributed to internal knowledge base improvements'
    ],
    tags: ['APPLE', 'iOS', 'macOS', 'CUSTOMER SUPPORT']
  }
];
---

<MainLayout
  title="Experience"
  description="Tactical Operations Log - Over a decade of IT operations, infrastructure management, and team leadership experience."
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <div class="header-content">
        <span class="header-label">OPERATIONAL HISTORY</span>
        <h1 class="page-title">TACTICAL OPERATIONS LOG</h1>
        <p class="header-description">
          Field-tested experience across corporate infrastructure, service delivery,
          and engineering management. Over 10 years of operational excellence.
        </p>
      </div>
    </div>
  </section>

  <!-- Timeline Section -->
  <section class="timeline-section">
    <div class="container">
      <div class="timeline">
        {experiences.map((exp, index) => (
          <div class="timeline-item" data-index={index}>
            <div class="timeline-marker">
              <span class="marker-dot"></span>
              <span class="marker-line"></span>
            </div>

            <div class="timeline-content">
              <TechnicalCard
                title={exp.title}
                subtitle={`${exp.company} | ${exp.location}`}
                meta={exp.period}
                showCorners={index === 0}
              >
                <p class="experience-description">{exp.description}</p>

                <div class="achievements-section">
                  <h4 class="achievements-title">KEY ACHIEVEMENTS:</h4>
                  <ul class="achievements-list">
                    {exp.achievements.map(achievement => (
                      <li>{achievement}</li>
                    ))}
                  </ul>
                </div>

                <div slot="footer">
                  {exp.tags.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </TechnicalCard>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-header">
        <h2 class="section-heading">■ OPERATIONAL METRICS</h2>
      </div>

      <div class="stats-grid">
        <div class="stat-box">
          <div class="stat-icon">⬢</div>
          <div class="stat-number">10+</div>
          <div class="stat-label">YEARS IN OPERATIONS</div>
        </div>

        <div class="stat-box">
          <div class="stat-icon">⬢</div>
          <div class="stat-number">6</div>
          <div class="stat-label">ORGANIZATIONS SERVED</div>
        </div>

        <div class="stat-box">
          <div class="stat-icon">⬢</div>
          <div class="stat-number">100+</div>
          <div class="stat-label">SYSTEMS DEPLOYED</div>
        </div>

        <div class="stat-box">
          <div class="stat-icon">⬢</div>
          <div class="stat-number">3+</div>
          <div class="stat-label">TEAM MEMBERS LED</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">EXPLORE CAPABILITIES</h2>
        <p class="cta-text">
          View technical skills, certifications, and specialized expertise.
        </p>
        <div class="cta-buttons">
          <a href="/skills" class="btn btn-primary">VIEW SKILLS MATRIX →</a>
          <a href="/contact" class="btn btn-outline">INITIATE CONTACT</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Page Header */
  .page-header {
    padding: var(--space-8) 0 var(--space-6);
    border-bottom: var(--border-thick) solid var(--border-heavy);
  }

  .header-label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--accent-orange);
    display: block;
    margin-bottom: var(--space-2);
  }

  .page-title {
    font-size: var(--text-5xl);
    margin-bottom: var(--space-3);
  }

  .header-description {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-width: 700px;
  }

  /* Timeline Section */
  .timeline-section {
    padding: var(--space-8) 0;
  }

  .timeline {
    position: relative;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-item:last-child .marker-line {
    display: none;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .marker-dot {
    width: 20px;
    height: 20px;
    background: var(--accent-orange);
    border: var(--border-thick) solid var(--border-heavy);
    border-radius: 50%;
    position: relative;
    z-index: 2;
  }

  .timeline-item[data-index="0"] .marker-dot {
    background: var(--accent-green);
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .marker-line {
    width: 3px;
    flex: 1;
    background: var(--border-light);
    margin-top: var(--space-1);
  }

  .timeline-content {
    padding-bottom: var(--space-2);
  }

  /* Experience Content */
  .experience-description {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .achievements-section {
    margin-top: var(--space-3);
  }

  .achievements-title {
    font-family: var(--font-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--accent-blue);
    margin-bottom: var(--space-2);
  }

  .achievements-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .achievements-list li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    padding-left: var(--space-3);
    margin-bottom: var(--space-1);
    position: relative;
  }

  .achievements-list li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--accent-green);
    font-weight: var(--font-bold);
  }

  /* Tags */
  :global(.tag) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    padding: var(--space-1) var(--space-2);
    background: var(--accent-blue);
    color: var(--text-inverted);
    border: var(--border-thin) solid var(--border-heavy);
    display: inline-block;
  }

  /* Stats Section */
  .stats-section {
    padding: var(--space-8) 0;
    background: var(--bg-secondary);
    border-top: var(--border-thick) solid var(--border-heavy);
    border-bottom: var(--border-thick) solid var(--border-heavy);
  }

  .section-heading {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-6);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .stat-box {
    text-align: center;
    padding: var(--space-4);
    border: var(--border-medium) solid var(--border-heavy);
    background: var(--bg-elevated);
    transition: all var(--transition-base);
  }

  .stat-box:hover {
    transform: translateY(-4px);
    border-color: var(--accent-blue);
  }

  .stat-icon {
    font-size: var(--text-3xl);
    color: var(--accent-orange);
    margin-bottom: var(--space-2);
  }

  .stat-number {
    font-family: var(--font-primary);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--text-tertiary);
  }

  /* CTA Section */
  .cta-section {
    padding: var(--space-8) 0 var(--space-12);
  }

  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-3);
  }

  .cta-text {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: var(--text-4xl);
    }

    .header-description {
      font-size: var(--text-base);
    }

    .timeline-item {
      grid-template-columns: 40px 1fr;
      gap: var(--space-2);
    }

    .marker-dot {
      width: 16px;
      height: 16px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .cta-title {
      font-size: var(--text-3xl);
    }
  }
</style>
