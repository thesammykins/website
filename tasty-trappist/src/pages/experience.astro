        companyDomain: "ferocia.com.au",
        logoFallback: null,
        location: "Melbourne (Hybrid)",
        period: "Jun 2025 – Present",
        description:
            "Doing things.",
        achievements: [
            "Maintained critical IT infrastructure and fleet of 100+ devices",
            "Managed Jamf MDM deployment and ongoing device operations",
