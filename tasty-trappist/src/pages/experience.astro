    },
    {
        title: "SERVICE DESK LEAD",
        company: "Redbubble",
        companyUrl: "https://www.redbubble.com/",
        companyDomain: "redbubble.com",
        logoFallback: "/company-logo-redbubble.jpg",
        location: "Melbourne",
        period: "Jun 2022 – Dec 2022",
        description:
            "Led a service desk team of 3, managing day-to-day IT support operations for Bubblers with weekly 1:1s, team syncs, and cross-departmental coordination.",
        achievements: [
