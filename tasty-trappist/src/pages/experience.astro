            "Developed universal system image for corporation-wide deployment",
            "Investigated new hardware including tablets and VMware Thin Clients",
            "Maintained Town of Gawler website through Unity CMS",
        ],
        tags: ["LOCAL GOVERNMENT", "SYSTEM IMAGING", "ACTIVE DIRECTORY"],
    },
    {
        title: "DIGITAL LOCAL GOVERNMENT PROJECT OFFICER",
        company: "Town of Gawler",
        companyUrl: "https://www.gawler.sa.gov.au/",
        companyDomain: "gawler.sa.gov.au",
        logoFallback: "/company-logo-gawler.jpg",
        location: "Gawler, SA",
        period: "Aug 2013 – Aug 2014",
        description:
            "Led video conferencing and unified communications project for Town of Gawler and community. Managed vendor selection, infrastructure implementation, and community training.",
        achievements: [
            "Created framework for video conferencing facilities for community use",
            "Worked through tender process and vendor selection",
            "Implemented unified communications into existing infrastructure",
            "Developed training plans for community service accessibility",
        ],
        tags: ["PROJECT MANAGEMENT", "VIDEO CONFERENCING", "COMMUNITY"],
    },
];
---

<MainLayout
    title="Experience"
    description="Tactical Operations Log - 14+ years of IT operations, infrastructure management, and team leadership experience."
>
    <!-- Page-Level Background Portrait -->
    <div slot="page-background" class="hero-background">
        <PixelatedCanvas
            src="/hero-experience.png"
            alt=""
            className="background-portrait"
            pixelSize={12}
            fadeInterval={1500}
            fadePixelsPerTick={800}
            fadeSpeed={0.02}
            initialOpacityMin={0.6}
            initialOpacityMax={1.0}
            fadeOutMin={0.2}
            fadeOutMax={0.4}
            fadeInMin={0.8}
            fadeInMax={1.0}
            hoverRadius={3}
            hoverFadeStrength={0.6}
            enableHover={true}
            autoRestore={true}
            edgeBlurTop={150}
            edgeBlurLeft={200}
            edgeBlurBottom={150}
            pixelOffsetX={0}
            pixelOffsetY={0}
            enableAlignment={false}
            enableRandomFade={true}
            client:load
        />
        <div class="background-gradient"></div>
    </div>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <div class="header-content">
                <span class="header-label">OPERATIONAL HISTORY</span>
                <h1 class="page-title">TACTICAL OPERATIONS LOG</h1>
                <p class="header-description">
                    Field-tested experience across corporate infrastructure,
                    service delivery, and engineering management. 14+ years of
                    operational excellence from local government to global tech
                    companies.
                </p>
            </div>
        </div>
    </section>

    <!-- Timeline Section -->
    <section class="timeline-section">
        <div class="container">
            <div class="timeline">
                {
                    experiences.map((exp, index) => (
                        <div class="timeline-item" data-index={index}>
                            <div class="timeline-marker">
                                <span class="marker-dot" />
                                <span class="marker-line" />
                            </div>

                            <div class="timeline-content">
                                <TechnicalCard
                                    title={exp.title}
                                    subtitle={`${exp.company} | ${exp.location}`}
                                    meta={exp.period}
                                    showCorners={index === 0}
                                >
                                    {(getLogoUrl(exp.companyDomain) || exp.logoFallback) && (
                                        <div class="company-logo-wrapper">
                                            {exp.companyUrl ? (
                                                <a
                                                    href={exp.companyUrl}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="company-logo-link"
                                                >
                                                    <img
                                                        src={getLogoUrl(exp.companyDomain) || exp.logoFallback}
                                                        alt={`${exp.company} logo`}
                                                        class="company-logo"
                                                        loading="lazy"
                                                    />
                                                </a>
                                            ) : (
                                                <img
                                                    src={getLogoUrl(exp.companyDomain) || exp.logoFallback}
                                                    alt={`${exp.company} logo`}
                                                    class="company-logo"
                                                    loading="lazy"
                                                />
                                            )}
                                        </div>
                                    )}
                                    <p class="experience-description">
                                        {exp.description}
                                    </p>

                                    <div class="achievements-section">
                                        <h4 class="achievements-title">
                                            KEY ACHIEVEMENTS:
                                        </h4>
                                        <ul class="achievements-list">
                                            {exp.achievements.map(
                                                (achievement) => (
                                                    <li>{achievement}</li>
                                                ),
                                            )}
                                        </ul>
                                    </div>

                                    <div slot="footer">
                                        {exp.tags.map((tag) => (
                                            <span class="tag">{tag}</span>
                                        ))}
                                    </div>
                                </TechnicalCard>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="container">
            <div class="stats-header">
                <h2 class="section-heading">■ OPERATIONAL METRICS</h2>
            </div>

            <div class="stats-grid">
                <div class="stat-box">
                    <div class="stat-icon">⬢</div>
                    <div class="stat-number">14+</div>
                    <div class="stat-label">YEARS IN OPERATIONS</div>
                </div>

                <div class="stat-box">
                    <div class="stat-icon">⬢</div>
                    <div class="stat-number">9</div>
                    <div class="stat-label">ORGANIZATIONS SERVED</div>
                </div>

                <div class="stat-box">
                    <div class="stat-icon">⬢</div>
                    <div class="stat-number">100+</div>
                    <div class="stat-label">DEVICES MANAGED</div>
                </div>

                <div class="stat-box">
                    <div class="stat-icon">⬢</div>
                    <div class="stat-number">3</div>
                    <div class="stat-label">TEAM MEMBERS LED</div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-content">
                <h2 class="cta-title">EXPLORE CAPABILITIES</h2>
                <p class="cta-text">
                    View technical skills, certifications, and specialized
                    expertise.
                </p>
                <div class="cta-buttons">
                    <a href="/skills" class="btn btn-primary"
                        >VIEW SKILLS MATRIX →</a
                    >
                    <a href="/contact" class="btn btn-outline"
                        >INITIATE CONTACT</a
                    >
                </div>
            </div>
        </div>
    </section>
</MainLayout>

<style>
    /* Hero Background */
    :global(.hero-background .background-portrait) {
        position: absolute;
        right: -5%;
        top: 50%;
        transform: translateY(-50%);
        height: 100vh;
        width: auto;
        object-fit: contain;
        opacity: 0.25;
        image-rendering: pixelated;
        image-rendering: -moz-crisp-edges;
        image-rendering: crisp-edges;
    }

    :global(.hero-background .background-gradient) {
        display: none;
    }

    @keyframes scan {
        0% {
            top: 0%;
        }
        100% {
            top: 100%;
        }
    }

    /* Page Header */
    .page-header {
        padding: var(--space-8) 0 var(--space-6);
        background: transparent;
        position: relative;
        z-index: 10;
    }

    .header-label {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wider);
        color: var(--accent-orange);
        display: block;
        margin-bottom: var(--space-2);
    }

    .page-title {
        font-size: var(--text-5xl);
        margin-bottom: var(--space-3);
    }

    .header-description {
        font-family: var(--font-mono);
        font-size: var(--text-lg);
        line-height: var(--leading-relaxed);
        color: var(--text-secondary);
        max-width: 700px;
    }

    /* Timeline Section */
    .timeline-section {
        padding: var(--space-8) 0;
        position: relative;
        z-index: 10;
    }

    .timeline {
        position: relative;
    }

    .timeline-item {
        display: grid;
        grid-template-columns: 60px 1fr;
        gap: var(--space-4);
        margin-bottom: var(--space-6);
    }

    .timeline-item:last-child {
        margin-bottom: 0;
    }

    .timeline-item:last-child .marker-line {
        display: none;
    }

    .timeline-marker {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
    }

    .marker-dot {
        width: 20px;
        height: 20px;
        background: var(--accent-orange);
        border: var(--border-thick) solid var(--border-heavy);
        border-radius: 50%;
        position: relative;
        z-index: 2;
    }

    .timeline-item[data-index="0"] .marker-dot {
        background: var(--accent-green);
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    .marker-line {
        width: 3px;
        flex: 1;
        background: var(--border-light);
        margin-top: var(--space-1);
    }

    .timeline-content {
        padding-bottom: var(--space-2);
    }

    /* Company Logo */
    .company-logo-wrapper {
        float: right;
        margin: 0 0 var(--space-3) var(--space-3);
    }

    .company-logo-link {
        display: block;
        transition: all var(--transition-base);
    }

    .company-logo-link:hover {
        transform: scale(1.05);
        opacity: 0.8;
    }

    .company-logo {
        width: 120px;
        height: 120px;
        object-fit: contain;
        border: var(--border-medium) solid var(--border-heavy);
        background: var(--bg-elevated);
        padding: var(--space-3);
        border-radius: 4px;
        transition: filter var(--transition-base);
    }

    /* Desaturate logos in dark mode */
    :global([data-theme="dark"]) .company-logo {
        filter: grayscale(60%) brightness(0.9);
    }

    :global([data-theme="dark"]) .company-logo-link:hover .company-logo {
        filter: grayscale(30%) brightness(1);
    }

    /* Experience Content */
    .experience-description {
        font-family: var(--font-mono);
        font-size: var(--text-base);
        line-height: var(--leading-relaxed);
        color: var(--text-secondary);
        margin-bottom: var(--space-4);
    }

    .achievements-section {
        margin-top: var(--space-3);
    }

    .achievements-title {
        font-family: var(--font-primary);
        font-size: var(--text-sm);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wider);
        color: var(--accent-blue);
        margin-bottom: var(--space-2);
    }

    .achievements-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .achievements-list li {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-secondary);
        padding-left: var(--space-3);
        margin-bottom: var(--space-1);
        position: relative;
    }

    .achievements-list li::before {
        content: "▸";
        position: absolute;
        left: 0;
        color: var(--accent-green);
        font-weight: var(--font-bold);
    }

    /* Tags */
    :global(.tag) {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wider);
        padding: var(--space-1) var(--space-2);
        background: var(--accent-blue);
        color: var(--text-inverted);
        border: var(--border-thin) solid var(--border-heavy);
        display: inline-block;
    }

    /* Stats Section */
    .stats-section {
        padding: var(--space-8) 0;
        background: var(--bg-secondary);
        border-top: var(--border-thick) solid var(--border-heavy);
        border-bottom: var(--border-thick) solid var(--border-heavy);
        position: relative;
        z-index: 10;
    }

    .section-heading {
        font-size: var(--text-3xl);
        margin-bottom: var(--space-6);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
    }

    .stat-box {
        text-align: center;
        padding: var(--space-4);
        border: var(--border-medium) solid var(--border-heavy);
        background: var(--bg-elevated);
        transition: all var(--transition-base);
    }

    .stat-box:hover {
        transform: translateY(-4px);
        border-color: var(--accent-blue);
    }

    .stat-icon {
        font-size: var(--text-3xl);
        color: var(--accent-orange);
        margin-bottom: var(--space-2);
    }

    .stat-number {
        font-family: var(--font-primary);
        font-size: var(--text-4xl);
        font-weight: var(--font-bold);
        color: var(--text-primary);
        margin-bottom: var(--space-1);
    }

    .stat-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wider);
        color: var(--text-tertiary);
    }

    /* CTA Section */
    .cta-section {
        padding: var(--space-8) 0 var(--space-12);
        background: var(--bg-elevated);
        position: relative;
        z-index: 10;
    }

    .cta-content {
        text-align: center;
        max-width: 600px;
        margin: 0 auto;
    }

    .cta-title {
        font-size: var(--text-4xl);
        margin-bottom: var(--space-3);
    }

    .cta-text {
        font-family: var(--font-mono);
        font-size: var(--text-lg);
        color: var(--text-secondary);
        margin-bottom: var(--space-6);
    }

    .cta-buttons {
        display: flex;
        gap: var(--space-3);
        justify-content: center;
        flex-wrap: wrap;
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .company-logo {
            width: 100px;
            height: 100px;
        }
    }

    @media (max-width: 768px) {
        .page-title {
            font-size: var(--text-4xl);
        }

        .header-description {
            font-size: var(--text-base);
        }

        .timeline-item {
            grid-template-columns: 40px 1fr;
            gap: var(--space-2);
        }

        .marker-dot {
            width: 16px;
            height: 16px;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .cta-title {
            font-size: var(--text-3xl);
        }

        .company-logo {
            width: 80px;
            height: 80px;
            padding: var(--space-2);
        }
    }
</style>
