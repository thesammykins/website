---
// Contact Page - Command Center Style
import MainLayout from "../layouts/MainLayout.astro";
import BorderBox from "../components/BorderBox.astro";
import PixelatedCanvas from "../components/PixelatedCanvas.svelte";
import TechnicalHeader from "../components/TechnicalHeader.astro";
import TechnicalDivider from "../components/TechnicalDivider.astro";
import StatusIndicator from "../components/StatusIndicator.astro";
---

<MainLayout
    title="Contact"
    description="Initiate contact with Samantha Myers for engineering management, IT operations, and infrastructure leadership opportunities."
>
    <!-- Page-Level Background Portrait -->
    <div slot="page-background" class="hero-background">
        <PixelatedCanvas
            src="/hero-contact.png"
            alt=""
            className="background-portrait"
            pixelSize={8}
            fadeInterval={1500}
            fadePixelsPerTick={800}
            fadeSpeed={0.02}
            initialOpacityMin={0.6}
            initialOpacityMax={1.0}
            fadeOutMin={0.2}
            fadeOutMax={0.4}
            fadeInMin={0.8}
            fadeInMax={1.0}
            hoverRadius={3}
            hoverFadeStrength={0.6}
            enableHover={true}
            autoRestore={true}
            edgeBlurTop={150}
            edgeBlurLeft={200}
            edgeBlurBottom={150}
            pixelOffsetX={0}
            pixelOffsetY={0}
            enableAlignment={false}
            enableRandomFade={true}
            client:load
        />
        <div class="background-gradient"></div>
    </div>

    <!-- Technical Header -->
    <div class="container">
        <TechnicalHeader sector="COMMS CENTER" status="OPERATIONAL" showTimestamp={true} />
    </div>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <div class="header-content">
                <span class="header-label">
                    COMMUNICATIONS CENTER
                    <StatusIndicator status="active" label="" showLabel={false} size="sm" />
                </span>
                <h1 class="page-title">INITIATE CONTACT</h1>
                <p class="header-description">
                    Available for engineering management, IT operations
                    leadership, and strategic infrastructure roles. Response
                    time: 24-48 hours.
                </p>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact-section">
        <div class="container">
            <TechnicalDivider label="CONTACT PROTOCOL" variant="thick" />

            <div class="contact-grid">
                <!-- Contact Info -->
                <BorderBox variant="tactical" class="contact-info">
                    <h2 class="info-heading">■ CONTACT DETAILS</h2>

                    <div class="info-items">
                        <div class="info-item">
                            <div class="info-label">EMAIL:</div>
                            <a
                                href="mailto:me+website@samanthamyers.au"
                                class="info-value"
                            >
                                me+website@samanthamyers.au
                            </a>
                        </div>

                        <div class="info-item">
                            <div class="info-label">LINKEDIN:</div>
                            <a
                                href="https://www.linkedin.com/in/sammyers12/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="info-value"
                            >
                                linkedin.com/in/sammyers12
                            </a>
                        </div>

                        <div class="info-item">
                            <div class="info-label">BLOG:</div>
                            <a
                                href="https://blog.sammykins.au"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="info-value"
                            >
                                blog.sammykins.au
                            </a>
                        </div>

                        <div class="info-item">
                            <div class="info-label">LOCATION:</div>
                            <span class="info-value">Melbourne, Australia</span>
                        </div>

                        <div class="info-item">
                            <div class="info-label">AVAILABILITY:</div>
                            <span class="info-value status-active"
                                >OPERATIONAL</span
                            >
                        </div>
                    </div>

                    <div class="availability-note">
                        <h3 class="note-title">◆ OPEN TO ROLES:</h3>
                        <ul class="roles-list">
                            <li>Corporate Engineering Manager</li>
                            <li>Lead Technical Support Engineer</li>
                            <li>Service Desk Lead</li>
                            <li>IT Operations Manager</li>
                            <li>Infrastructure Lead</li>
                        </ul>
                    </div>
                </BorderBox>

                <!-- Contact Form -->
                <BorderBox variant="clipped" class="contact-form-wrapper">
                    <h2 class="form-heading">▲ SEND MESSAGE</h2>

                    <form
                        class="contact-form"
                        id="contact-form"
                    >
                        <div class="form-group">
                            <label for="name" class="form-label">NAME:</label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                class="form-input"
                                placeholder="Enter your name"
                            />
                        </div>

                        <div class="form-group">
                            <label for="email" class="form-label">EMAIL:</label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                class="form-input"
                                placeholder="your@email.com"
                            />
                        </div>

                        <div class="form-group">
                            <label for="company" class="form-label"
                                >COMPANY (OPTIONAL):</label
                            >
                            <input
                                type="text"
                                id="company"
                                name="company"
                                class="form-input"
                                placeholder="Your organization"
                            />
                        </div>

                        <div class="form-group">
                            <label for="message" class="form-label"
                                >MESSAGE:</label
                            >
                            <textarea
                                id="message"
                                name="message"
                                required
                                rows="6"
                                class="form-textarea"
                                placeholder="Tell me about the opportunity or project..."
                            ></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary btn-full">
                            TRANSMIT MESSAGE →
                        </button>
                    </form>

                    <script>
                        document.getElementById('contact-form')?.addEventListener('submit', function(e) {
                            e.preventDefault();

                            const name = (document.getElementById('name') as HTMLInputElement)?.value || '';
                            const email = (document.getElementById('email') as HTMLInputElement)?.value || '';
                            const company = (document.getElementById('company') as HTMLInputElement)?.value || '';
                            const message = (document.getElementById('message') as HTMLTextAreaElement)?.value || '';

                            const subject = company
                                ? `Website Contact: ${name} (${company})`
                                : `Website Contact: ${name}`;

                            const body = `Name: ${name}
Email: ${email}
${company ? `Company: ${company}\n` : ''}
Message:
${message}`;

                            const mailtoLink = `mailto:me+website@samanthamyers.au?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
                            window.location.href = mailtoLink;
                        });
                    </script>
                </BorderBox>
            </div>
        </div>
    </section>

    <!-- System Status Section -->
    <section class="status-section">
        <div class="container">
            <BorderBox variant="default">
                <div class="status-grid">
                    <div class="status-item">
                        <div class="status-icon">●</div>
                        <div class="status-content">
                            <div class="status-label">RESPONSE TIME</div>
                            <div class="status-value">24-48 HRS</div>
                        </div>
                    </div>

                    <div class="status-item">
                        <div class="status-icon status-icon--active">●</div>
                        <div class="status-content">
                            <div class="status-label">AVAILABILITY</div>
                            <div class="status-value">OPERATIONAL</div>
                        </div>
                    </div>

                    <div class="status-item">
                        <div class="status-icon">●</div>
                        <div class="status-content">
                            <div class="status-label">TIMEZONE</div>
                            <div class="status-value">AEST (UTC+10)</div>
                        </div>
                    </div>

                    <div class="status-item">
                        <div class="status-icon">●</div>
                        <div class="status-content">
                            <div class="status-label">WORK HOURS</div>
                            <div class="status-value">8AM-6PM</div>
                        </div>
                    </div>
                </div>
            </BorderBox>
        </div>
    </section>

    <TechnicalDivider label="NAVIGATION LINKS" variant="default" />

    <!-- Additional Links Section -->
    <section class="links-section">
        <div class="container">
            <h2 class="section-heading">□ ADDITIONAL RESOURCES</h2>

            <div class="links-grid">
                <a href="/about" class="link-card">
                    <div class="link-icon">◆</div>
                    <div class="link-content">
                        <h3 class="link-title">ABOUT & PROFILE</h3>
                        <p class="link-desc">
                            Learn about operational philosophy and background
                        </p>
                    </div>
                    <div class="link-arrow">→</div>
                </a>

                <a href="/experience" class="link-card">
                    <div class="link-icon">■</div>
                    <div class="link-content">
                        <h3 class="link-title">OPERATIONS LOG</h3>
                        <p class="link-desc">
                            View complete work history and achievements
                        </p>
                    </div>
                    <div class="link-arrow">→</div>
                </a>

                <a href="/skills" class="link-card">
                    <div class="link-icon">▲</div>
                    <div class="link-content">
                        <h3 class="link-title">SKILLS MATRIX</h3>
                        <p class="link-desc">
                            Explore technical capabilities and certifications
                        </p>
                    </div>
                    <div class="link-arrow">→</div>
                </a>
            </div>
        </div>
    </section>
</MainLayout>

<style>
    /* Hero Background */
    :global(.hero-background .background-portrait) {
        position: absolute;
        right: -5%;
        top: 50%;
        transform: translateY(-50%);
        height: 100vh;
        width: auto;
        object-fit: contain;
        opacity: 0.25;
        image-rendering: pixelated;
        image-rendering: -moz-crisp-edges;
        image-rendering: crisp-edges;
    }

    :global(.hero-background .background-gradient) {
        display: none;
    }

    @keyframes scan {
        0% {
            top: 0%;
        }
        100% {
            top: 100%;
        }
    }

    /* Page Header */
    .page-header {
        padding: var(--space-8) 0 var(--space-6);
        background: transparent;
        position: relative;
        z-index: 10;
    }

    .header-label {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wider);
        color: var(--accent-orange);
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-bottom: var(--space-2);
    }

    .page-title {
        font-size: var(--text-5xl);
        margin-bottom: var(--space-3);
    }

    .header-description {
        font-family: var(--font-mono);
        font-size: var(--text-lg);
        line-height: var(--leading-relaxed);
        color: var(--text-secondary);
        max-width: 700px;
    }

    /* Contact Section */
    .contact-section {
        padding: var(--space-8) 0;
        position: relative;
        z-index: 10;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 400px 1fr;
        gap: var(--space-6);
        align-items: start;
    }

    /* Contact Info */
    .contact-info {
        position: sticky;
        top: calc(80px + var(--space-2)); /* Nav height + spacing */
    }

    .info-heading {
        font-size: var(--text-2xl);
        margin-bottom: var(--space-4);
    }

    .info-items {
        margin-bottom: var(--space-6);
    }

    .info-item {
        margin-bottom: var(--space-3);
    }

    .info-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wider);
        color: var(--text-tertiary);
        margin-bottom: var(--space-1);
        display: block;
    }

    .info-value {
        font-family: var(--font-mono);
        font-size: var(--text-base);
        color: var(--text-secondary);
        word-break: break-word;
    }

    .info-value.status-active {
        color: var(--accent-green);
        font-weight: var(--font-bold);
    }

    .availability-note {
        padding-top: var(--space-4);
        border-top: var(--border-thin) solid var(--border-light);
    }

    .note-title {
        font-family: var(--font-primary);
        font-size: var(--text-base);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        color: var(--accent-orange);
        margin-bottom: var(--space-2);
    }

    .roles-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .roles-list li {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-secondary);
        padding-left: var(--space-3);
        margin-bottom: var(--space-1);
        position: relative;
    }

    .roles-list li::before {
        content: "▸";
        position: absolute;
        left: 0;
        color: var(--accent-blue);
        font-weight: var(--font-bold);
    }

    /* Contact Form */
    .form-heading {
        font-size: var(--text-2xl);
        margin-bottom: var(--space-4);
    }

    .contact-form {
        /* Form styles */
    }

    .form-group {
        margin-bottom: var(--space-4);
    }

    .form-label {
        display: block;
        margin-bottom: var(--space-1);
    }

    .form-input,
    .form-textarea {
        width: 100%;
    }

    .form-textarea {
        resize: vertical;
        min-height: 120px;
    }

    .btn-full {
        width: 100%;
    }

    .hidden {
        display: none;
    }

    /* Status Section */
    .status-section {
        padding: var(--space-8) 0;
        position: relative;
        z-index: 10;
    }

    .status-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-6);
    }

    .status-item {
        display: flex;
        gap: var(--space-3);
        align-items: center;
    }

    .status-icon {
        font-size: var(--text-3xl);
        color: var(--text-tertiary);
    }

    .status-icon--active {
        color: var(--accent-green);
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    .status-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wider);
        color: var(--text-tertiary);
        margin-bottom: var(--space-1);
    }

    .status-value {
        font-family: var(--font-primary);
        font-size: var(--text-lg);
        font-weight: var(--font-bold);
        color: var(--text-primary);
    }

    /* Links Section */
    .links-section {
        padding: var(--space-8) 0 var(--space-12);
        position: relative;
        z-index: 10;
    }

    .section-heading {
        font-size: var(--text-3xl);
        margin-bottom: var(--space-6);
    }

    .links-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-4);
    }

    .link-card {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-4);
        border: var(--border-thick) solid var(--border-heavy);
        background: var(--bg-elevated);
        text-decoration: none;
        transition: all var(--transition-base);
    }

    .link-card:hover {
        border-color: var(--accent-blue);
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0 var(--border-heavy);
    }

    .link-icon {
        font-size: var(--text-2xl);
        color: var(--accent-orange);
    }

    .link-content {
        flex: 1;
    }

    .link-title {
        font-family: var(--font-primary);
        font-size: var(--text-base);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        color: var(--text-primary);
        margin-bottom: var(--space-1);
    }

    .link-desc {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--text-secondary);
        margin: 0;
    }

    .link-arrow {
        font-family: var(--font-primary);
        font-size: var(--text-2xl);
        color: var(--accent-blue);
        transition: transform var(--transition-base);
    }

    .link-card:hover .link-arrow {
        transform: translateX(4px);
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }

        .contact-info {
            position: static;
        }

        .status-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .links-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .page-title {
            font-size: var(--text-4xl);
        }

        .header-description {
            font-size: var(--text-base);
        }

        .status-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
