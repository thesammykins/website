---
// MainLayout - Base layout for all pages
import { ViewTransitions } from "astro:transitions";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import GridPattern from "../components/GridPattern.svelte";
import StatusBar from "../components/StatusBar.astro";
import "../styles/global.css";

export interface Props {
    title: string;
    description?: string;
    showStatusBar?: boolean;
    statusBarItems?: string[];
}

const {
    title,
    description = "Corporate Engineering Manager specializing in IT operations, infrastructure, and team leadership.",
    showStatusBar = true,
    statusBarItems = [
        "FIELD TESTED IN ADELAIDE, AU",
        "OPERATIONAL IN MELBOURNE, AU",
        "SYSTEMS OPERATIONAL",
        "LAST UPDATED: OCT 2025",
        "AVAILABLE FOR OPPORTUNITIES",
        "10+ YEARS EXPERIENCE",
        "ENGINEERING LEADERSHIP",
        "IT SUPPORT",
        "AI EVANGELISM",
        "CONTACT FOR INQUIRIES",
    ],
} = Astro.props;

const fullTitle = `${title} | Samantha Myers`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />

        <title>{fullTitle}</title>

        <!-- Favicon -->
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/favicon_io/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon_io/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon_io/favicon-16x16.png"
        />
        <link rel="manifest" href="/favicon_io/site.webmanifest" />
        <link rel="icon" type="image/x-icon" href="/favicon_io/favicon.ico" />

        <!-- Preconnect to Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <!-- Open Graph / Social Meta -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={Astro.url.href} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />

        <!-- View Transitions for smooth page changes -->
        <ViewTransitions />
    </head>
    <body>
        <!-- Background grid pattern -->
        <GridPattern client:load opacity={0.3} gridSize={40} animate={true} />

        <!-- Page-level background (optional, for index page) -->
        <slot name="page-background" />

        <!-- Top status bar (optional) -->
        {showStatusBar && <StatusBar position="top" items={statusBarItems} />}

        <!-- Navigation -->
        <Navigation />

        <!-- Main content -->
        <main id="main-content" class="main-content">
            <slot />
        </main>

        <!-- Footer -->
        <Footer />

        <!-- Bottom status bar (optional) -->
        {
            showStatusBar && (
                <StatusBar position="bottom" items={statusBarItems} />
            )
        }
    </body>
</html>

<style>
    :global(html) {
        scroll-padding-top: 80px; /* Account for sticky nav */
    }

    :global(body) {
        position: relative;
        z-index: 1;
        max-width: 100vw;
    }

    .main-content {
        position: relative;
        z-index: 50;
        min-height: 60vh;
    }

    /* Dark mode toggle (if needed later) */
    :global([data-theme="dark"]) {
        color-scheme: dark;
    }

    /* Ensure grid pattern stays in back */
    :global(.grid-pattern) {
        z-index: 0;
    }

    /* Ensure page-background slot content stays behind everything */
    :global(.hero-background),
    :global(.profile-background) {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: -1;
        pointer-events: none;
        view-transition-name: page-background;
        max-width: 100vw;
        overflow: hidden;
    }

    /* Ensure backgrounds stay behind during transitions */
    ::view-transition-old(page-background),
    ::view-transition-new(page-background) {
        z-index: -1 !important;
        mix-blend-mode: normal;
        animation: none !important; /* Disable default fade animation */
    }

    /* Prevent background from covering content during transition */
    ::view-transition-group(page-background) {
        z-index: -1 !important;
    }

    ::view-transition-image-pair(page-background) {
        isolation: isolate;
    }

    /* Keep background portraits visible during transitions - no animation */
    :global(.background-portrait) {
        view-transition-name: none !important;
    }

    /* Also prevent canvas elements from animating */
    :global(canvas) {
        view-transition-name: none !important;
    }

    /* Customize transition duration for smoother effect */
    @media (prefers-reduced-motion: no-preference) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
            animation-duration: 0.3s;
            animation-timing-function: ease-in-out;
        }

        ::view-transition-old(page-background),
        ::view-transition-new(page-background) {
            animation-duration: 0.6s;
            animation-timing-function: ease-in-out;
            z-index: -1 !important;
        }
    }
</style>
