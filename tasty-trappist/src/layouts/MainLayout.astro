---
// MainLayout - Base layout for all pages
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import GridPattern from "../components/GridPattern.svelte";
import StatusBar from "../components/StatusBar.astro";
import { ClientRouter } from "astro:transitions";
import headingFont from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import bodyFont from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import "../styles/global.css";
import "../styles/page-transitions.css";
import { employment } from "../data/employment";

export interface Props {
    title: string;
    description?: string;
    showStatusBar?: boolean;
    statusBarItems?: string[];
}

const {
    title,
    description = "Samantha Myers — corporate engineering, IT operations, technical support and team leadership in Melbourne, Australia.",
    showStatusBar = true,
    statusBarItems = [
        "FIELD TESTED IN ADELAIDE, AU",
        "OPERATIONAL IN MELBOURNE, AU",
        "SYSTEMS OPERATIONAL",
        employment.availableForDeployment ? "AVAILABLE FOR OPPORTUNITIES" : `${employment.currentRole.title} AT ${employment.currentRole.company.toUpperCase()}`,
        "CORPORATE ENGINEERING",
        "ENGINEERING LEADERSHIP",
        "IT SUPPORT",
        "AI EVANGELISM",
        "CONTACT FOR INQUIRIES",
    ],
} = Astro.props;

const fullTitle = `${title} | Samantha Myers`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <ClientRouter fallback="swap" />

        <title>{fullTitle}</title>
        <script>
            import { autoplay } from "../components/autoplay";
            import { swapFunctions } from "astro:transitions/client";
            import type { TransitionBeforePreparationEvent, TransitionBeforeSwapEvent } from "astro:transitions/client";

            autoplay.subscribe((playing) => {
                document.documentElement.dataset.autoplay = playing ? "playing" : "paused";
            });
            let activeTransition: TransitionBeforeSwapEvent["viewTransition"] | undefined;
            let contentReady: Promise<void> = Promise.resolve();
            document.addEventListener("astro:before-preparation", (event) => {
                const preparation = event as TransitionBeforePreparationEvent;
                const previous = activeTransition;
                if (!previous) return;
                const loader = preparation.loader;
                // Fetch immediately, but let the existing edge reach its end
                // instead of Astro cancelling it and exposing a whole page at once.
                const handoff = Promise.allSettled([previous.ready, contentReady]).then(async () => {
                    if (activeTransition !== previous) return;
                    const wipe = document.getAnimations().find(animation =>
                        animation instanceof CSSAnimation && animation.animationName === "pixel-reveal",
                    );
                    if (wipe?.effect && typeof wipe.currentTime === "number") {
                        const remaining = Number(wipe.effect.getComputedTiming().endTime) - wipe.currentTime;
                        if (remaining > 160) wipe.playbackRate = remaining / 160;
                    }
                    await previous.finished;
                });
                preparation.loader = async () => {
                    await Promise.all([loader(), handoff]);
                };
            });
            document.addEventListener("astro:before-swap", (event) => {
                const transition = event as TransitionBeforeSwapEvent;
                activeTransition = transition.viewTransition;
                void transition.viewTransition.finished.finally(() => {
                    if (activeTransition === transition.viewTransition) activeTransition = undefined;
                });
                const nextRoot = transition.newDocument.documentElement;
                const currentRoot = document.documentElement;
                nextRoot.classList.add("js");
                nextRoot.dataset.theme = currentRoot.dataset.theme;
                nextRoot.dataset.autoplay = currentRoot.dataset.autoplay;
                nextRoot.dataset.pagePreparing = "";

                // Keep the shell in its original DOM position, not merely retained
                // and lifted into <html> during Astro's whole-body replacement.
                transition.swap = () => {
                    swapFunctions.deselectScripts(transition.newDocument);
                    swapFunctions.swapRootAttributes(transition.newDocument);
                    swapFunctions.swapHeadElements(transition.newDocument);
                    const restoreFocus = swapFunctions.saveFocus();
                    swapFunctions.swapBodyElement(
                        transition.newDocument.querySelector(".page-content")!,
                        document.querySelector(".page-content")!,
                    );
                    restoreFocus();
                };

                // Astro prepares HTML/CSS before swapping, but islands and images
                // can still be loading. Hold the old snapshot until the first view
                // is ready, without waiting for lazy content below the fold.
                contentReady = transition.viewTransition.updateCallbackDone.then(async () => {
                    // A new request aborts Astro's fetch signal, not the view
                    // already on screen: that view still needs a clean handoff.
                    const signal = AbortSignal.timeout(8000);
                    const content = document.querySelector(".page-content");
                    const assets: Promise<unknown>[] = [];
                    for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-pixelated-state="loading"]')) {
                        if (!canvas.getBoundingClientRect().width) continue;
                        assets.push(new Promise(resolve => {
                            canvas.addEventListener("pixelated:ready", resolve, { once: true, signal });
                        }));
                    }
                    for (const image of document.querySelectorAll<HTMLImageElement>(".page-content img")) {
                        const box = image.getBoundingClientRect();
                        if (box.width && box.bottom > 0 && box.top < innerHeight) {
                            image.loading = "eager";
                            assets.push(image.decode());
                        }
                    }
                    assets.push(document.fonts.ready);
                    // A failed asset must not trap navigation; a stalled island
                    // has a bounded fallback.
                    await Promise.race([
                        Promise.allSettled(assets),
                        new Promise(resolve => {
                            if (signal.aborted) resolve(undefined);
                            else signal.addEventListener("abort", resolve, { once: true });
                        }),
                    ]);
                    if (content === document.querySelector(".page-content")) delete currentRoot.dataset.pagePreparing;
                }, () => { /* Interrupted snapshots need no readiness work. */ });
            });
        </script>
        <!-- Feedback remains available, but must not compete with initial content. -->
        <script is:inline>
            window.addEventListener("load", function () {
                function loadFeedback() {
                    var script = document.createElement("script");
                    script.src = "https://ampcode.com/w/client_01M6R22GADAY9T3THMPMJGVHNG.js";
                    script.async = true;
                    document.head.appendChild(script);
                }
                if ("requestIdleCallback" in window) {
                    window.requestIdleCallback(loadFeedback, { timeout: 2000 });
                } else {
                    window.setTimeout(loadFeedback, 0);
                }
            }, { once: true });
        </script>

        <!-- Run before rendering; storage may be unavailable in private contexts. -->
        <script is:inline>
            (function () {
                document.documentElement.classList.add("js");
                var theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                try {
                    var saved = localStorage.getItem("theme");
                    if (saved === "light" || saved === "dark") theme = saved;
                } catch { /* Browser storage is optional; system preferences still apply. */ }
                document.documentElement.setAttribute("data-theme", theme);
            })();
        </script>

        <!-- Favicon -->
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/favicon_io/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon_io/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon_io/favicon-16x16.png"
        />
        <link rel="manifest" href="/favicon_io/site.webmanifest" />
        <link rel="icon" type="image/x-icon" href="/favicon_io/favicon.ico" />

        <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

        <!-- Open Graph / Social Meta -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
        <link rel="alternate" type="text/plain" href="/llms.txt" title="Agent-readable profile" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />

    </head>
    <body>
        <!-- Skip to main content link for keyboard users -->
        <a href="#main-content" class="skip-link">Skip to main content</a>

        <!-- Keep the complete header in place, even when navigating from deep scroll. -->
        <header class="site-header" transition:persist="header">
            {showStatusBar && <StatusBar position="top" items={statusBarItems} />}
            <Navigation />
        </header>

        <!-- Snapshot only this region so the header stays live during navigation. -->
        <div class="page-content">
            <GridPattern opacity={0.3} gridSize={40} animate={true} transition:persist="grid" />
            <div aria-hidden="true"><slot name="page-background" /></div>
            <main id="main-content" class="main-content" tabindex="-1">
                <slot />
            </main>
            <Footer />
            {showStatusBar && <StatusBar position="bottom" items={statusBarItems} />}
        </div>
    </body>
</html>

<style>
    :global(html) {
        /* Globe, nav spacing, ticker and a gap above focused content. */
        scroll-padding-top: calc(64px + var(--space-4) + var(--border-thick) + var(--space-6) + var(--space-2));
        view-transition-name: none;
    }

    .site-header {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
    }

    .page-content {
        background: var(--bg-primary);
        view-transition-name: content;
    }

    :global(body) {
        position: relative;
        z-index: 1;
        max-width: 100vw;
    }

    .main-content {
        position: relative;
        z-index: 50;
        min-height: 60vh;
    }

    /* Skip link — visually hidden until focused */
    :global(.skip-link) {
        position: absolute;
        top: -100%;
        left: var(--space-2);
        z-index: 10000;
        font-family: var(--font-primary);
        font-size: var(--text-base);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
        background: var(--accent-orange);
        color: var(--text-inverted);
        padding: var(--space-2) var(--space-4);
        border: var(--border-thick) solid var(--border-heavy);
        text-decoration: none;
        transition: top 150ms ease;
    }

    :global(.skip-link:focus) {
        top: var(--space-2);
    }

    :global(.skip-link:focus-visible) {
        outline: 3px solid var(--accent-blue);
        outline-offset: 2px;
    }

    /* Dark mode toggle (if needed later) */
    :global([data-theme="dark"]) {
        color-scheme: dark;
    }

    /* Ensure grid pattern stays in back */
    :global(.grid-pattern) {
        z-index: 0;
    }

    /* Ensure page-background slot content stays behind everything */
    :global(.hero-background),
    :global(.profile-background) {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: -1;
        pointer-events: none;
        max-width: 100vw;
        overflow: hidden;
        background: var(--bg-primary);
    }
</style>
